{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Uptick": {
    "Api": {
      "BaseUrl": "https://fyrepower.onuptick.com/api/v2.15/",
      "MaxRequestsPerMinute": 60,
      "MaxConcurrency": 2,
      "PageSize": 5000,
      "ThrottledPageSize": 1000
    },
    "Mapping": {
      "KeepFyreAppEdits": false
    }
  },
  "Storage": {
    "Provider": "",
    "Local": {
      "Root": "App_Data/files"
    },
    "S3": {
      "Bucket": "",
      "Region": "ap-southeast-2",
      "ServiceUrl": ""
    }
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "FyreApp",
    "UseSsl": true
  }
}
