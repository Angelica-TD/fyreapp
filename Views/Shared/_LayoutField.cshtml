@* The technicians' field app: a phone screen with nothing to navigate. A bar with My day and the menu (password, log
   out; an admin gets back to the rest of FyreApp), then the page. No sidebar, no breadcrumbs. *@
@{
    var onMyDay = ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#212529" />
    <title>@ViewData["Title"] - FyreApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/bootstrap.custom.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/logo.png" />
    <style>
        body.field { background: #f3f4f6; overflow-x: hidden; }
        /* Nothing wider than the phone: long names wrap, buttons too */
        .field-main { overflow-wrap: anywhere; }
        .field-main .btn { white-space: normal; }
        .field-main .d-flex > * { min-width: 0; }
        .field-bar { position: sticky; top: 0; z-index: 1030; }
        .field-main { max-width: 760px; margin: 0 auto; padding: 1rem 1rem 7rem; }
        /* The clock: always in reach at the bottom of the job */
        .field-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1030;
                      padding: .75rem 1rem calc(.75rem + env(safe-area-inset-bottom)); }
        .field-dock-inner { max-width: 760px; margin: 0 auto; }
        .field-step { display: inline-flex; align-items: center; justify-content: center; width: 1.75rem; height: 1.75rem;
                      border-radius: 50%; font-size: .9rem; font-weight: 600; flex-shrink: 0; }
        .field-main .btn-group > .btn { padding-top: .6rem; padding-bottom: .6rem; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="field">
    <header class="field-bar bg-dark text-white">
        <div class="d-flex align-items-center gap-2 px-3 py-2" style="max-width: 760px; margin: 0 auto">
            @if (onMyDay)
            {
                <span class="fw-semibold fs-5 me-auto">My day</span>
            }
            else
            {
                <a class="btn btn-outline-light me-auto" asp-controller="Field" asp-action="Index">
                    <i class="bi bi-chevron-left"></i> My day
                </a>
            }
            <div class="dropdown">
                <button class="btn btn-outline-light" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu">
                    <i class="bi bi-person-circle"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><span class="dropdown-item-text small text-muted">@User.Identity?.Name</span></li>
                    @if (isAdmin)
                    {
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-grid"></i> Back to FyreApp</a></li>
                    }
                    <li><a class="dropdown-item" asp-controller="Auth" asp-action="ChangePassword"><i class="bi bi-key"></i> Change password</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Log out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <main class="field-main">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
