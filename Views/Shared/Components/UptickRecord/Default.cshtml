@model IReadOnlyList<FyreApp.Infrastructure.UptickRecordViewComponent.Field>

@* Every field of the record's raw copy from Uptick's API *@
@if (Model.Count > 0)
{
    <details class="mt-3">
        <summary class="text-muted small">Uptick data (@Model.Count fields)</summary>
        <dl class="row small mt-2 mb-0">
            @foreach (var f in Model)
            {
                <dt class="col-sm-4 text-muted fw-normal">@f.Name</dt>
                <dd class="col-sm-8" style="white-space: pre-line; overflow-wrap: anywhere">@f.Value</dd>
            }
        </dl>
    </details>
}
