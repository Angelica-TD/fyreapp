@model FyreApp.ViewModels.Field.FieldTaskVm
@using System.Globalization
@using FyreApp.Services.Field
@{
    var task = Model.Task;
    var p = task.Property;
    ViewData["Title"] = $"{task.DisplayRef} {p.Name}";
    string Time(DateTime? utc) => utc is { } d ? d.ToSydney().ToString("h:mmtt", CultureInfo.InvariantCulture).ToLowerInvariant() : "";
    string Hours(decimal? h) => h is { } n ? $"{n:0.##} h" : "";
    var access = new (string Label, string? Value)[]
    {
        ("Access times", p.AccessSchedule), ("Access procedure", p.AccessProcedure), ("Access code", p.AccessCode),
        ("Access note", p.AccessNote), ("Service requirements", p.ServiceRequirements), ("About the task", task.Description)
    }.Where(a => !string.IsNullOrWhiteSpace(a.Value)).ToList();
    var routines = Model.Lines.GroupBy(l => l.Routine).ToList();
    var canWork = Model.CannotWork == null;
    var line = 0;
    var shownRemarks = new HashSet<int>();
    var caller = Model.Contacts.FirstOrDefault(c => !string.IsNullOrWhiteSpace(c.Mobile));
    var step = 0;

    var assetsDone = Model.Lines.Count > 0 && Model.Lines.All(l => l.Result != null);
    var linesDone = Model.TaskLines.Count > 0 && Model.TaskLines.All(l => l.IsPerformed);
    var signedOff = Model.SignOff != null;
}

@* A step of the job: its number, ticked once done *@
@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent Step(int n, bool done) =>
        new Microsoft.AspNetCore.Html.HtmlString(done
            ? "<span class=\"field-step bg-success text-white\"><i class=\"bi bi-check-lg\"></i></span>"
            : $"<span class=\"field-step bg-secondary-subtle text-secondary-emphasis\">{n}</span>");
}

@* The technician's job: where it is, then the work in order (test the assets, the task's lines, stock, forms,
   the customer's sign-off), with their clock docked at the bottom. Nothing to navigate. *@

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

@* Where *@
<div class="mb-3">
    <div class="small text-muted">@task.DisplayRef@(task.Category != null ? $" · {task.Category}" : "")</div>
    <h1 class="h4 mb-0">@p.Name</h1>
    @if (p.AddressDisplay != null) { <div class="text-muted">@p.AddressDisplay</div> }
    <div class="mt-1">@task.Title</div>

    <div class="d-flex gap-2 mt-2">
        @if (Model.MapsUrl != null)
        {
            <a class="btn btn-primary flex-grow-1" href="@Model.MapsUrl" target="_blank" rel="noopener"><i class="bi bi-sign-turn-right"></i> Directions</a>
        }
        @if (caller != null)
        {
            <a class="btn btn-outline-success flex-grow-1" href="tel:@caller.Mobile!.Replace(" ", "")"><i class="bi bi-telephone"></i> Call @caller.Name.Split(' ')[0]</a>
        }
    </div>

    @if (access.Count > 0 || Model.Contacts.Count > 0 || Model.Appointments.Count > 0)
    {
        <details class="card mt-2">
            <summary class="card-body py-2 small">
                <i class="bi bi-info-circle"></i> Site info: access, contacts, booking
                @if (p.AccessCode != null) { <span class="badge text-bg-warning ms-1">Access code</span> }
            </summary>
            <div class="card-body pt-0">
                @foreach (var a in access)
                {
                    <div class="mt-2">
                        <div class="small text-muted">@a.Label</div>
                        <div style="white-space: pre-line">@a.Value</div>
                    </div>
                }
                @foreach (var c in Model.Contacts)
                {
                    <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                        <span>@c.Name @if (c.Role != null) { <span class="small text-muted">· @c.Role</span> }</span>
                        <span class="text-nowrap">
                            @if (!string.IsNullOrWhiteSpace(c.Mobile))
                            {
                                <a class="btn btn-sm btn-outline-success" href="tel:@c.Mobile.Replace(" ", "")" aria-label="Call @c.Name"><i class="bi bi-telephone"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.Email))
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="mailto:@c.Email" aria-label="Email @c.Name"><i class="bi bi-envelope"></i></a>
                            }
                        </span>
                    </div>
                }
                @foreach (var a in Model.Appointments)
                {
                    <div class="mt-2 small">
                        <i class="bi bi-calendar-event"></i> @a.StartUtc.ToSydney().ToOrdinalDateTime()@(a.EndUtc != null ? $" – {Time(a.EndUtc)}" : ""):
                        @string.Join(", ", a.Technicians.Select(t => t.Name).Order())
                        @if (!string.IsNullOrWhiteSpace(a.Notes)) { <div style="white-space: pre-line">@a.Notes</div> }
                    </div>
                }
            </div>
        </details>
    }
</div>

@if (!canWork)
{
    <div class="alert alert-secondary">@Model.CannotWork</div>
}

@* 1. Test the assets *@
<section class="mb-4" id="assets">
    <h2 class="h5 d-flex align-items-center gap-2 mb-2">@Step(++step, assetsDone) Test the assets</h2>
    @if (routines.Count == 0)
    {
        <div class="card"><div class="card-body text-muted">No assets listed on this job.</div></div>
    }
    @foreach (var group in routines)
    {
        <div class="card mb-3 js-routine">
            <div class="card-header d-flex justify-content-between gap-2">
                <span class="fw-semibold small">@(string.IsNullOrWhiteSpace(group.Key) ? "Assets" : group.Key)</span>
                <span class="small text-nowrap"><span class="js-done">@group.Count(l => l.Result != null)</span> of @group.Count()</span>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var l in group)
                {
                    var n = line++;
                    var open = l.Result == "Fail" || !string.IsNullOrEmpty(l.Notes);
                    <li class="list-group-item py-3" id="asset-@l.AssetId">
                        <div>
                            <span class="fw-semibold">@(l.AssetRef ?? l.Asset)</span>
                            @if (l.AssetRef != null) { <span class="text-muted">@l.Asset</span> }
                            @if (l.Location != null) { <div class="small text-muted"><i class="bi bi-geo-alt"></i> @l.Location</div> }
                        </div>
                        @* An asset serviced for more than one routine lists its remarks once *@
                        @if (shownRemarks.Add(l.AssetId))
                        {
                            <partial name="_Remarks" model="new FyreApp.ViewModels.Field.FieldRemarksList(task.Id, l.Remarks, canWork)" />
                        }
                        <form method="post" asp-action="Record" asp-route-id="@task.Id" class="js-result mt-2">
                            <fieldset disabled="@(!canWork)">
                                <input type="hidden" name="assetId" value="@l.AssetId" />
                                <input type="hidden" name="routine" value="@l.Routine" />
                                <div class="btn-group w-100" role="group" aria-label="Result">
                                    @foreach (var r in FieldService.Results)
                                    {
                                        var id = $"r{n}-{r.Replace("/", "")}";
                                        var style = r switch { "Pass" => "success", "Fail" => "danger", _ => "secondary" };
                                        <input type="radio" class="btn-check" name="result" value="@r" id="@id" autocomplete="off" checked="@(l.Result == r)" />
                                        <label class="btn btn-outline-@style fw-semibold" for="@id">@r</label>
                                    }
                                </div>
                                @* A note, and raising a remark: offered when it fails (or on asking) *@
                                <div class="js-more mt-2 @(open ? "" : "d-none")">
                                    <input type="text" name="notes" value="@l.Notes" class="form-control mb-2" placeholder="Note (what you found)" maxlength="2000" />
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-warning flex-grow-1 js-remark" href="@Url.Action("Remark", new { id = task.Id, assetId = l.AssetId })">
                                            <i class="bi bi-exclamation-triangle"></i> Raise a remark
                                        </a>
                                        <button type="button" class="btn btn-outline-secondary js-clear @(l.Result == null ? "d-none" : "")">Clear result</button>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <button type="button" class="btn btn-link btn-sm px-0 text-muted js-show-more @(open ? "d-none" : "")">Add a note or remark</button>
                                    <span class="small js-status ms-auto" aria-live="polite"></span>
                                </div>
                                <button type="submit" class="btn btn-sm btn-outline-secondary js-save">Save</button>
                            </fieldset>
                        </form>
                    </li>
                }
            </ul>
        </div>
    }

    @* Remarks on the property itself, or assets not on the list *@
    @if (Model.OtherRemarks.Count > 0)
    {
        <div class="card mb-2"><div class="card-body py-2">
            <div class="small text-muted">Other remarks raised here</div>
            <partial name="_Remarks" model="new FyreApp.ViewModels.Field.FieldRemarksList(task.Id, Model.OtherRemarks, canWork)" />
        </div></div>
    }
    @if (canWork)
    {
        <a class="btn btn-outline-warning w-100" href="@Url.Action("Remark", new { id = task.Id })">
            <i class="bi bi-exclamation-triangle"></i> Something else wrong at the site? Raise a remark
        </a>
    }
</section>

@* 2. The task's lines (Uptick's subtasks): routines due and products, ticked off once done *@
@if (Model.TaskLines.Count > 0)
{
    <section class="mb-4 js-lines" id="lines">
        <h2 class="h5 d-flex align-items-center gap-2 mb-2">
            @Step(++step, linesDone) Tick off the job's lines
            <span class="small text-muted fw-normal ms-auto"><span class="js-done">@Model.TaskLines.Count(l => l.IsPerformed)</span> of @Model.TaskLines.Count</span>
        </h2>
        <div class="card">
            <ul class="list-group list-group-flush">
                @foreach (var tl in Model.TaskLines)
                {
                    <li class="list-group-item py-3">
                        <form method="post" asp-action="Line" asp-route-id="@task.Id" class="js-line d-flex align-items-center gap-3">
                            <input type="hidden" name="subtaskId" value="@tl.Id" />
                            <input class="form-check-input fs-3 m-0 flex-shrink-0" type="checkbox" name="done" value="true" id="line-@tl.Id"
                                   checked="@tl.IsPerformed" disabled="@(!canWork)" />
                            <input type="hidden" name="done" value="false" />
                            <label class="form-check-label flex-grow-1" for="line-@tl.Id">
                                @tl.Label
                                @if (tl.Due != null) { <span class="small text-muted d-block">due @tl.Due.ToOrdinalDate()</span> }
                            </label>
                            <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Save</button></noscript>
                            <span class="small js-status" aria-live="polite"></span>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </section>
}

@* 3. Stock used *@
<section class="mb-4" id="stock">
    <h2 class="h5 d-flex align-items-center gap-2 mb-2">@Step(++step, Model.StockUsed.Count > 0) Stock used <span class="small text-muted fw-normal">if any</span></h2>
    <div class="card">
        @if (Model.StockUsed.Count > 0)
        {
            <ul class="list-group list-group-flush">
                @foreach (var s in Model.StockUsed)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span><strong>@s.Quantity.ToString("0.##")</strong> × @s.Product <span class="small text-muted d-block">@s.By</span></span>
                        @if (s.Removable && canWork)
                        {
                            <form method="post" asp-action="RemoveStock" asp-route-id="@task.Id" asp-route-useId="@s.Id"
                                  data-confirm="Remove @s.Quantity.ToString("0.##") × @s.Product?" onsubmit="return confirm(this.dataset.confirm)">
                                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Remove"><i class="bi bi-x-lg"></i></button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        @if (canWork)
        {
            <div class="card-body">
                <form method="post" asp-action="Stock" asp-route-id="@task.Id">
                    <select name="productId" class="form-select mb-2" aria-label="Product" required>
                        <option value="">Pick a product…</option>
                        @foreach (var pr in Model.Products)
                        {
                            <option value="@pr.Id">@pr.Name@(pr.Code != null ? $" ({pr.Code})" : "")</option>
                        }
                    </select>
                    <div class="d-flex gap-2">
                        <input type="number" name="quantity" value="1" min="0.01" max="10000" step="0.01" inputmode="decimal"
                               class="form-control" style="max-width: 6rem" aria-label="How many" required />
                        <button type="submit" class="btn btn-outline-primary flex-grow-1">Add</button>
                    </div>
                </form>
            </div>
        }
    </div>
</section>

@* 4. Forms *@
@if (Model.Forms.Count > 0 || (canWork && Model.FormTemplates.Count > 0))
{
    <section class="mb-4" id="forms">
        <h2 class="h5 d-flex align-items-center gap-2 mb-2">@Step(++step, Model.Forms.Count > 0) Forms <span class="small text-muted fw-normal">if the job needs one</span></h2>
        <div class="card">
            @if (Model.Forms.Count > 0)
            {
                <ul class="list-group list-group-flush">
                    @foreach (var f in Model.Forms)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <span><i class="bi bi-check-circle text-success"></i> @f.Name@(f.Ref != null ? $" {f.Ref}" : "")</span>
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("SubmittedForm", new { id = task.Id, responseId = f.Id })">View</a>
                        </li>
                    }
                </ul>
            }
            @if (canWork && Model.FormTemplates.Count > 0)
            {
                <div class="card-body d-grid gap-2">
                    @foreach (var t in Model.FormTemplates)
                    {
                        <a class="btn btn-outline-primary text-start" href="@Url.Action("Form", new { id = task.Id, version = t.VersionId })">
                            <i class="bi bi-ui-checks"></i> Fill in @t.Name
                        </a>
                    }
                </div>
            }
        </div>
    </section>
}

@* 5. The customer's sign-off *@
<section class="mb-4" id="signoff">
    <h2 class="h5 d-flex align-items-center gap-2 mb-2">@Step(++step, signedOff) Customer sign-off</h2>
    <div class="card"><div class="card-body">
        @if (Model.SignOff is { } so)
        {
            @if (so.SigneeName != null)
            {
                <div>Signed by <strong>@so.SigneeName</strong> <span class="small text-muted">· @Time(so.SignedUtc)</span></div>
                @if (so.SignatureFileId != null)
                {
                    <img src="/Files/@so.SignatureFileId" alt="Signature of @so.SigneeName" class="border rounded bg-white mt-2" style="max-width: 100%; max-height: 8rem" />
                }
            }
            else
            {
                <div>Not signed: @so.NoSignatureReason</div>
            }
        }
        @if (canWork)
        {
            <details class="@(signedOff ? "mt-2" : "")" open="@(!signedOff)">
                <summary class="small text-muted mb-2 @(signedOff ? "" : "d-none")">Sign again</summary>
                <form method="post" asp-action="SignOff" asp-route-id="@task.Id">
                    <input name="signee" class="form-control mb-2" maxlength="300" autocomplete="off" placeholder="Customer's name" aria-label="Customer's name" />
                    <partial name="_SignaturePad" model="@("signature")" />
                    <button type="submit" class="btn btn-primary w-100 mb-2">Save signature</button>
                    <details>
                        <summary class="small text-muted">Nobody to sign?</summary>
                        <div class="d-flex gap-2 mt-2">
                            <input name="noSignatureReason" class="form-control" maxlength="1000" placeholder="Why, e.g. nobody on site" aria-label="Why it wasn't signed" />
                            <button type="submit" class="btn btn-outline-secondary text-nowrap">Save</button>
                        </div>
                    </details>
                </form>
            </details>
        }
        else if (!signedOff)
        {
            <div class="small text-muted">Not signed off.</div>
        }
    </div></div>
</section>

@* 6. Finish: closes the task and writes its report. What's still open is said first, but doesn't stop it (not every
   asset can always be reached) *@
@if (canWork)
{
    var untested = Model.Lines.Count(l => l.Result == null);
    var failed = Model.Lines.Where(l => l.Result == "Fail").Select(l => l.AssetId).Distinct().Count();
    var unticked = Model.TaskLines.Count(l => !l.IsPerformed);
    var gaps = new List<string>();
    if (untested > 0) gaps.Add($"{untested} {(untested == 1 ? "asset" : "assets")} not tested");
    if (unticked > 0) gaps.Add($"{unticked} {(unticked == 1 ? "line" : "lines")} not ticked off");
    if (!signedOff) gaps.Add("no customer sign-off");
    <section class="mb-4" id="finish">
        <h2 class="h5 d-flex align-items-center gap-2 mb-2">@Step(++step, false) Finish the job</h2>
        <div class="card"><div class="card-body">
            @if (gaps.Count > 0)
            {
                <ul class="list-unstyled mb-2">
                    @foreach (var g in gaps)
                    {
                        <li class="text-warning-emphasis"><i class="bi bi-exclamation-circle"></i> @(char.ToUpper(g[0]) + g[1..])</li>
                    }
                </ul>
            }
            else
            {
                <div class="text-success mb-2"><i class="bi bi-check-circle"></i> Everything's done.</div>
            }
            @if (failed > 0)
            {
                <div class="small text-muted mb-2">@failed @(failed == 1 ? "asset" : "assets") failed: the report shows it not compliant.</div>
            }
            <form method="post" asp-action="Complete" asp-route-id="@task.Id" class="js-geo"
                  data-confirm="@(gaps.Count > 0 ? $"Still open: {string.Join(", ", gaps)}.\n\n" : "")Complete this job? It can't be changed after.">
                <input type="hidden" name="lat" /><input type="hidden" name="lng" />
                <textarea name="note" class="form-control mb-2" rows="3" maxlength="4000" placeholder="Note for the report (optional)" aria-label="Note for the report"></textarea>
                <button type="submit" class="btn btn-success btn-lg w-100"><i class="bi bi-check2-all"></i> Complete the job</button>
                @if (Model.Running != null) { <div class="small text-muted mt-1 text-center">This stops your clock.</div> }
            </form>
        </div></div>
    </section>
}
else if (task.Status == ClientTaskStatus.Completed)
{
    <div class="alert alert-success"><i class="bi bi-check2-all"></i> Completed@(task.CompletedUtc != null ? $" {task.CompletedUtc.Value.ToSydney().ToOrdinalDateTime()}" : "").</div>
}

@if (User.IsInRole("Admin"))
{
    <p class="small"><a asp-controller="Task" asp-action="Details" asp-route-id="@task.Id">The task's full page</a></p>
}

@* The clock, docked at the bottom: the one thing to press next *@
@if (canWork)
{
    var running = Model.Running;
    var today = Model.MyTimeToday.Where(s => s.FinishedUtc != null).Sum(s => s.Hours ?? 0);
    <div class="field-dock bg-white border-top shadow">
        <div class="field-dock-inner">
            @if (running != null)
            {
                <div class="small mb-2 d-flex justify-content-between">
                    <span><i class="bi bi-stopwatch text-success"></i> <strong>@(running.IsOnsite ? "Working" : "Travelling")</strong> since @Time(running.StartedUtc)</span>
                    @if (today > 0) { <span class="text-muted">@Hours(today) earlier today</span> }
                </div>
                <div class="d-flex gap-2">
                    @if (!running.IsOnsite)
                    {
                        <form method="post" asp-action="Start" asp-route-id="@task.Id" class="js-geo flex-grow-1">
                            <input type="hidden" name="lat" /><input type="hidden" name="lng" />
                            <button type="submit" name="type" value="Performing Task" class="btn btn-success btn-lg w-100"><i class="bi bi-play-fill"></i> Arrived: start work</button>
                        </form>
                    }
                    <form method="post" asp-action="Finish" asp-route-id="@task.Id" class="js-geo @(running.IsOnsite ? "flex-grow-1" : "")">
                        <input type="hidden" name="lat" /><input type="hidden" name="lng" />
                        <button type="submit" class="btn @(running.IsOnsite ? "btn-danger btn-lg w-100" : "btn-outline-danger btn-lg")"><i class="bi bi-stop-fill"></i> @(running.IsOnsite ? "Finish work" : "Stop")</button>
                    </form>
                </div>
            }
            else
            {
                @if (Model.RunningElsewhere is { } other)
                {
                    <div class="small text-warning-emphasis mb-2">Your clock is running on @other.TaskRef at @other.PropertyName: starting here stops it.</div>
                }
                else if (today > 0)
                {
                    <div class="small text-muted mb-2">@Hours(today) on this job today</div>
                }
                <form method="post" asp-action="Start" asp-route-id="@task.Id" class="js-geo d-flex gap-2">
                    <input type="hidden" name="lat" /><input type="hidden" name="lng" />
                    <button type="submit" name="type" value="Travelling" class="btn btn-outline-primary btn-lg"><i class="bi bi-truck"></i> Travel</button>
                    <button type="submit" name="type" value="Performing Task" class="btn btn-success btn-lg flex-grow-1"><i class="bi bi-play-fill"></i> Start work</button>
                </form>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/field.js" asp-append-version="true"></script>
}
