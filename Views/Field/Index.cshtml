@model FyreApp.ViewModels.Field.FieldDayVm
@using System.Globalization
@{
    ViewData["Title"] = "My day";
    var today = DateTime.UtcNow.ToSydney().Date;
    string Day(DateTime d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    string Time(DateTime? d) => d is { } t ? t.ToString("h:mmtt", CultureInfo.InvariantCulture).ToLowerInvariant() : "";
    string Heading(DateTime d) =>
        d == today ? "Today" : d == today.AddDays(1) ? "Tomorrow" : d == today.AddDays(-1) ? "Yesterday"
        : d.ToString("dddd", CultureInfo.InvariantCulture);
}

@* The technicians' field app: what they're booked on for a day, each opening the task's field page *@
<div class="field-app mx-auto" style="max-width: 720px">
    @* The day's jobs and their other open ones, kept on the phone to open without signal (field-sync.js, sw.js) *@
    <div hidden data-field-keep="@System.Text.Json.JsonSerializer.Serialize(Model.Visits.Concat(Model.Assigned).Select(v => v.TaskId).Distinct().Take(40).SelectMany(id => new[] { Url.Action("Visit", new { id }), Url.Action("Remark", new { id }) }))"></div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> @success</div>
    }
    @if (Model.Technician != null) { <div class="text-muted small mb-2">@Model.Technician</div> }

    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 mb-3">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", new { date = Day(Model.Day.AddDays(-1)) })" aria-label="Previous day">
            <i class="bi bi-chevron-left"></i>
        </a>
        <div class="flex-grow-1 text-center">
            <div class="fw-semibold">@Heading(Model.Day)</div>
            <div class="small text-muted">@Model.Day.ToDisplayDate()</div>
        </div>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", new { date = Day(Model.Day.AddDays(1)) })" aria-label="Next day">
            <i class="bi bi-chevron-right"></i>
        </a>
        @* The phone's date picker, opened from a button (the input itself is too wide for the row) *@
        <input type="date" name="date" value="@Day(Model.Day)" class="visually-hidden" id="pick-day" tabindex="-1" aria-hidden="true" onchange="this.form.submit()" />
        <button type="button" class="btn btn-outline-secondary" aria-label="Go to a day"
                onclick="const d = document.getElementById('pick-day'); d.showPicker ? d.showPicker() : d.click()"><i class="bi bi-calendar3"></i></button>
        @if (Model.Day != today)
        {
            <a class="btn btn-outline-primary" asp-action="Index">Today</a>
        }
    </form>

    @if (Model.NotLinked)
    {
        <div class="alert alert-info">
            Your login isn't linked to an Uptick user, so nothing is booked for you. An admin can link it on the Users page.
        </div>
    }

    @if (Model.Working is { } w)
    {
        <a class="alert alert-success d-flex align-items-center gap-2 text-decoration-none" href="@Url.Action("Visit", new { id = w.TaskId })">
            <i class="bi bi-stopwatch fs-4"></i>
            <span>
                <strong>@w.Category</strong> since @Time(w.StartLocal) on <strong>@w.TaskRef</strong> at @w.PropertyName
                <span class="d-block small">Open it to finish</span>
            </span>
        </a>
    }

    @if (!Model.NotLinked && Model.Visits.Count == 0)
    {
        <div class="card"><div class="card-body text-muted">Nothing booked for you on this day.</div></div>
    }

    <div class="list-group">
        @foreach (var v in Model.Visits)
        {
            <a class="list-group-item list-group-item-action py-3" href="@Url.Action("Visit", new { id = v.TaskId })">
                <div class="d-flex justify-content-between gap-2">
                    <span class="fw-semibold">
                        @(v.StartLocal != null ? $"{Time(v.StartLocal)}{(v.EndLocal != null ? " – " + Time(v.EndLocal) : "")}" : "Any time")
                    </span>
                    <span>
                        @if (v.Category != null) { <span class="badge text-bg-light border">@v.Category</span> }
                        @if (v.Status == ClientTaskStatus.InProgress) { <span class="badge text-bg-warning">In progress</span> }
                        else if (v.Status == ClientTaskStatus.Completed) { <span class="badge text-bg-success">Completed</span> }
                    </span>
                </div>
                <div class="mt-1"><span class="text-muted">@v.TaskRef</span> @v.Title</div>
                <div class="fw-semibold mt-1">@v.PropertyName</div>
                @if (v.Address != null) { <div class="small text-muted">@v.Address</div> }
                @if (!string.IsNullOrWhiteSpace(v.Notes)) { <div class="small mt-1" style="white-space: pre-line">@v.Notes</div> }
            </a>
        }
    </div>

    @if (Model.Assigned.Count > 0)
    {
        <h2 class="h5 mt-4 mb-2">Your other open tasks <span class="small text-muted fw-normal">@Model.Assigned.Count</span></h2>
        <div class="list-group">
            @foreach (var v in Model.Assigned)
            {
                <a class="list-group-item list-group-item-action py-2" href="@Url.Action("Visit", new { id = v.TaskId })">
                    <div class="d-flex justify-content-between gap-2">
                        <span><span class="text-muted">@v.TaskRef</span> @v.Title</span>
                        <span class="text-nowrap">
                            @if (v.Category != null) { <span class="badge text-bg-light border">@v.Category</span> }
                            @if (v.Status == ClientTaskStatus.InProgress) { <span class="badge text-bg-warning">In progress</span> }
                        </span>
                    </div>
                    <div class="fw-semibold small">@v.PropertyName</div>
                    <div class="small text-muted">
                        @(v.Scheduled != null ? $"Scheduled {v.Scheduled.ToOrdinalDate()}" : "Not scheduled")@(v.Due != null ? $" · due {v.Due.ToOrdinalDate()}" : "")
                    </div>
                </a>
            }
        </div>
    }
</div>
