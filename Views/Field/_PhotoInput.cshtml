@model string

@* Photos from the phone's camera or library: shrunk before sending (field.js), with previews *@
<div class="mb-3">
    <label for="photos" class="form-label">@Model</label>
    <input type="file" id="photos" name="photos" class="form-control js-photo-input" accept="image/*" multiple />
    <div class="d-flex flex-wrap gap-2 mt-2 js-photo-previews"></div>
    <div class="small text-muted js-photo-status"></div>
</div>
