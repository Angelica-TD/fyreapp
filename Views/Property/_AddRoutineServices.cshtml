@model FyreApp.ViewModels.Routines.AddRoutineServicesVm

@* Uptick's "Add routine services": dates and subcontractor, then tick routine types and the levels to do.
   Behaviour (search, standard filter, level chips, the count on the button) is in wwwroot/js/add-routine-services.js *@
<div class="modal fade" id="addRoutineServices" tabindex="-1" aria-labelledby="addRoutineServicesTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <form class="modal-content js-add-routines" asp-controller="Property" asp-action="AddRoutineServices" asp-route-id="@Model.SiteId" method="post">
            <div class="modal-header">
                <h2 class="modal-title h4" id="addRoutineServicesTitle">Add routine services</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-0">
                <div class="row g-3 bg-light border-bottom px-3 py-3 m-0">
                    <div class="col-md-3">
                        <label class="form-label" for="routineStart">Start date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="routineStart" name="StartDate" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="routineLastAnnual">Last annual date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="routineLastAnnual" name="LastAnnualDate" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="routineEnd">End date</label>
                        <input type="date" class="form-control" id="routineEnd" name="EndDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="routineSubcontractor">Subcontractor</label>
                        <select class="form-select" id="routineSubcontractor" name="Subcontractor">
                            <option value="">Not subcontracted</option>
                            @foreach (var c in Model.Contractors) { <option value="@c">@c</option> }
                        </select>
                    </div>
                </div>

                <div class="row g-3 px-3 py-3 m-0">
                    <div class="col-md-8">
                        <input type="search" class="form-control js-routine-search" placeholder="Search routine types" aria-label="Search routine types" />
                    </div>
                    <div class="col-md-4">
                        <select class="form-select js-routine-standard" aria-label="Standard">
                            <option value="">All standards</option>
                            @foreach (var s in Model.Standards) { <option value="@s">@s</option> }
                        </select>
                    </div>
                </div>

                <table class="table align-middle mb-0 add-routines-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 3rem"><input type="checkbox" class="form-check-input js-routine-all" aria-label="Select all routine types" /></th>
                            <th class="small text-uppercase fw-normal" style="width: 40%">Routine type</th>
                            <th class="small text-uppercase fw-normal">Levels</th>
                            <th class="small text-uppercase fw-normal text-end pe-3">Applicable assets</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Types.Any())
                        {
                            <tr><td colspan="4" class="text-muted ps-3">No routine types. Import Uptick's routine service types and levels on the Import page.</td></tr>
                        }
                        @foreach (var t in Model.Types)
                        {
                            <tr class="js-routine-row" data-name="@t.Name.ToLowerInvariant() @(t.Reference?.ToLowerInvariant())" data-standard="@t.Standard">
                                <td class="ps-3">
                                    <input type="checkbox" class="form-check-input js-routine-type" id="routineType@(t.Id)" aria-label="@t.Name"
                                           disabled="@(!t.Levels.Any())" />
                                </td>
                                <td>
                                    <label class="fw-semibold d-block" for="routineType@(t.Id)">@t.Name</label>
                                    @if (t.Reference != null) { <div class="small text-muted">@t.Reference</div> }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1 js-routine-levels" hidden>
                                        @foreach (var l in t.Levels)
                                        {
                                            <input type="checkbox" class="btn-check js-routine-level" name="Levels" value="@l.Id" id="routineLevel@(l.Id)"
                                                   data-default="@(l.DefaultEnabled ? "true" : "false")" autocomplete="off" />
                                            <label class="btn btn-sm btn-outline-primary rounded-pill routine-level-chip" for="routineLevel@(l.Id)">
                                                <i class="bi bi-check-lg"></i> @l.Name
                                            </label>
                                        }
                                    </div>
                                    @if (!t.Levels.Any()) { <span class="small text-muted">No active levels</span> }
                                </td>
                                <td class="text-end pe-3">
                                    @if (t.ApplicableAssets == 0 && t.ExistingRoutines == 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    @if (t.ApplicableAssets > 0)
                                    {
                                        <div><span class="badge bg-secondary" title="Active assets here this routine applies to">@t.ApplicableAssets</span></div>
                                    }
                                    @if (t.ExistingRoutines > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle text-uppercase mt-1">
                                            @t.ExistingRoutines @(t.ExistingRoutines == 1 ? "routine exists" : "routines exist")
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary js-routine-submit" disabled>Add 0 routine services</button>
            </div>
        </form>
    </div>
</div>
