@model IEnumerable<KeyValuePair<string, string>>
@using FyreApp.ViewModels.Lists

@* Edit N Properties: change status, or generate a task per property *@
<form method="post" asp-controller="Property" asp-action="BulkEdit" id="bulkForm">
    @await Html.PartialAsync("_BulkFormFields", Model)

    <div class="modal fade" id="bulkEditModal" tabindex="-1" aria-labelledby="bulkEditTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="bulkEditTitle">Edit <span class="js-selected-count">0</span> Properties</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>You have selected <span class="js-selected-count">0</span> properties. What do you want to do?</p>

                    <div class="form-check">
                        <input class="form-check-input js-bulk-action" type="radio" name="bulkAction" value="status" id="actStatus" checked />
                        <label class="form-check-label" for="actStatus">Change status</label>
                    </div>
                    <div class="border rounded p-3 mt-2 mb-2" data-for-action="status">
                        <label class="form-label" for="newStatus">New status</label>
                        <select class="form-select" name="newStatus" id="newStatus">
                            @foreach (var s in ListFilters.PropertyStatuses)
                            {
                                <option value="@s">@ListFilters.PropertyStatusLabel(s)</option>
                            }
                        </select>
                        <p class="small text-muted mt-2 mb-0">Inactive properties drop off the default lists; the others stay active.</p>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input js-bulk-action" type="radio" name="bulkAction" value="tasks" id="actTasks" />
                        <label class="form-check-label" for="actTasks">Generate a task for each property</label>
                    </div>
                    @await Html.PartialAsync("_BulkTaskFields", ("Property task", (string?)null))
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Apply</button>
                </div>
            </div>
        </div>
    </div>
</form>
