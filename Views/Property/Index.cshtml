@model FyreApp.ViewModels.Lists.PropertyListVm
@using FyreApp.ViewModels.Lists

@{
    ViewData["Title"] = "Properties";
    var f = Model.Filter;
    var filterValues = f.QueryValues().ToList();
    var canEdit = User.IsInRole("Admin");

    string StatusBadge(string? s) => s switch
    {
        "ACTIVE" => "bg-secondary",
        "ONHOLD" => "bg-warning text-dark",
        "SETUP" => "bg-info text-dark",
        _ => "bg-light text-dark border"
    };
}

<div class="card">
    <div class="card-header">
        <h1 class="h4 m-0">Properties</h1>
    </div>

    <div class="card-body">
        @await Html.PartialAsync("_SuccessAlert")

        <form method="get" asp-action="Index">
            <input type="hidden" name="f" value="true" />

            <div class="row g-2 mb-3">
                <div class="col">
                    <input type="search" name="search" value="@f.Search" class="form-control" placeholder="Search ref, property, address or client" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-light border" type="button" data-bs-toggle="collapse" data-bs-target="#propertyFilters"
                            aria-expanded="true" aria-controls="propertyFilters">
                        <i class="bi bi-funnel"></i> Filters
                        <span class="badge rounded-pill bg-secondary">@f.ActiveCount</span>
                    </button>
                </div>
            </div>

            <div class="collapse show bg-light border rounded p-3 mb-3" id="propertyFilters">
                <div class="row mb-3 align-items-center">
                    <span class="col-sm-3 col-form-label text-sm-end">Status:</span>
                    <div class="col-sm-9">
                        @foreach (var s in ListFilters.PropertyStatuses)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="status" value="@s" id="ps-@s"
                                       checked="@(f.Status.Contains(s) ? "checked" : null)" />
                                <label class="form-check-label" for="ps-@s">@ListFilters.PropertyStatusLabel(s)</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset to defaults</a>
                    <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                </div>
            </div>
        </form>

        @await Html.PartialAsync("_SelectionToolbar", new SelectionToolbarVm
        {
            Total = Model.Total, PageCount = Model.Items.Count, Noun = "Properties", NounSingular = "Property",
            DownloadUrl = Url.Action("Download") + "?" + FilterQuery.ToQueryString(filterValues),
            EditModalId = canEdit ? "bulkEditModal" : null
        })
        @if (canEdit)
        {
            @await Html.PartialAsync("_BulkEditModal", filterValues)
        }

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No properties match these filters.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            @if (canEdit)
                            {
                                <th style="width: 2rem"><input class="form-check-input js-select-page" type="checkbox" aria-label="Select all on this page" /></th>
                            }
                            <th>Ref</th>
                            <th>Status</th>
                            <th class="text-end">Created</th>
                            <th>Property</th>
                            <th>Address (state)</th>
                            <th>Client</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Items)
                        {
                            <tr>
                                @if (canEdit)
                                {
                                    <td><input class="form-check-input js-select-row" type="checkbox" name="ids" value="@p.Id" form="bulkForm" aria-label="Select" /></td>
                                }
                                <td><a asp-action="Details" asp-route-id="@p.Id">@(p.Ref ?? "—")</a></td>
                                <td><span class="badge @StatusBadge(p.Status)">@ListFilters.PropertyStatusLabel(p.Status).ToUpperInvariant()</span></td>
                                <td class="text-end text-nowrap">@(p.Created?.ToSydney().ToDisplayDate() ?? "—")</td>
                                <td>@p.Name</td>
                                <td>@(p.State ?? "—")</td>
                                <td>
                                    <a asp-controller="Clients" asp-action="Details" asp-route-id="@p.ClientId">@p.ClientName</a>
                                    @if (!string.IsNullOrWhiteSpace(p.ClientContact))
                                    {
                                        <span class="text-muted">· @p.ClientContact</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_ListPager", (f.Page, Model.Pages))
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/list-selection.js" asp-append-version="true"></script>
}
