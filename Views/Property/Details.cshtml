@model FyreApp.ViewModels.Sites.PropertyPageVm
@using FyreApp.Infrastructure
@using FyreApp.ViewModels.Sites

@* The property page, laid out like Uptick's: "P-0391 Ezfurn", a tab bar, one tab at a time *@
@{
    var site = Model.Site;
    ViewData["Title"] = $"{site.DisplayRef} {site.Name}".Trim();
    // Open remarks sit under Assets, as in Uptick
    var activeTab = Model.Tab == "remarks" ? "assets" : Model.Tab;
}

<div class="property-page">
    <h1 class="property-title">
        @if (site.DisplayRef != null)
        {
            <span class="property-title-ref">@site.DisplayRef</span>
        }
        <span class="property-title-name">@site.Name</span>
    </h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <ul class="nav nav-pills property-tabs mb-3">
        @foreach (var (key, label) in PropertyPageVm.Tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(key == activeTab ? "active" : "")" asp-action="Details" asp-route-id="@site.Id"
                   asp-route-tab="@(key == "property" ? null : key)">@label</a>
            </li>
        }
    </ul>

    @if (site.IsPlaceholder)
    {
        <div class="mb-3">@await Html.PartialAsync("_PlaceholderNotice", "property")</div>
    }

    @switch (Model.Tab)
    {
        case "assets":
            @await Html.PartialAsync("_AssetsTab", Model)
            break;
        case "remarks":
            @await Html.PartialAsync("_RemarksTab", Model)
            break;
        case "routines":
            @await Html.PartialAsync("_Routines", Model.Routines!)
            break;
        case "billing":
            @await Html.PartialAsync("_BillingTab", Model)
            break;
        case "records":
            @await Html.PartialAsync("_RecordsTab", Model)
            break;
        case "tasks":
            @await Html.PartialAsync("_TasksTab", Model)
            break;
        default:
            @await Html.PartialAsync("_PropertyTab", Model)
            break;
    }
</div>

@section Scripts {
    @if (Model.Tab == "assets")
    {
        <script src="~/js/asset-suggestions.js" asp-append-version="true"></script>
    }
}
