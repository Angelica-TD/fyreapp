@model FyreApp.Models.Site
@using FyreApp.Infrastructure

@{
    ViewData["Title"] = "Property Details";
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">
        @Model.Name
        @if (Model.DisplayRef != null)
        {
            <span class="badge bg-light text-dark border align-middle">@Model.DisplayRef</span>
        }
        @if (Model.Active)
        {
            <span class="badge bg-success align-middle">Active</span>
        }
        else
        {
            <span class="badge bg-secondary align-middle">Inactive</span>
        }
    </h1>

    @if (Model.Active)
    {
        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-sm btn-outline-warning"
                    onclick="return confirm('Deactivate this property?')">Deactivate</button>
        </form>
    }
    else
    {
        <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-sm btn-outline-success"
                    onclick="return confirm('Reactivate this property?')">Activate</button>
        </form>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <strong>Client:</strong>
    <a asp-controller="Clients"
       asp-action="Details"
       asp-route-id="@Model.Client.Id">
        @Model.Client.Name
    </a>
</p>

<p>
    <strong>Address:</strong>
    @if (!string.IsNullOrWhiteSpace(Model.AddressDisplay))
    {
        @Model.AddressDisplay
    }
    else if (!string.IsNullOrWhiteSpace(Model.AddressLine1))
    {
        @Model.AddressLine1
        if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
        {
            <br />@Model.AddressLine2
        }
        <br />@($"{Model.Suburb} {Model.State} {Model.Postcode}".Trim())
    }
    else
    {
        <span class="text-muted">No address on file</span>
    }
</p>

<hr />

<a class="btn btn-primary"
   asp-controller="Task"
   asp-action="Create"
   asp-route-clientId="@Model.ClientId"
   asp-route-siteId="@Model.Id">
    Add Task
</a>

<hr />

<h2>Assets</h2>

@if (!Model.Assets.Any())
{
    <p class="text-muted">No assets found for this property.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ref</th>
                <th>Asset Name</th>
                <th>Types</th>
                <th>Location</th>
                <th>Last service</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asset in Model.Assets.OrderBy(a => !a.IsActive).ThenBy(a => a.Name))
            {
                <tr class="@(asset.IsActive ? "" : "text-muted")">
                    <td class="text-nowrap">@asset.DisplayRef</td>
                    <td>
                        @asset.Name
                        @if (!asset.IsActive)
                        {
                            <span class="badge bg-secondary ms-1">Inactive</span>
                        }
                    </td>
                    <td>
                        @foreach (var type in asset.AssetTypes)
                        {
                            <span class="badge bg-secondary me-1">@type.Name</span>
                        }
                    </td>
                    <td>@asset.Location</td>
                    <td class="text-nowrap">@asset.LastServiceDate?.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-controller="Assets"
                           asp-action="Details"
                           asp-route-id="@asset.Id">
                            View Asset
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<form asp-action="CreateAsset" method="post">
    <input type="hidden" name="siteId" value="@Model.Id" />
    <div class="form-group" style="position:relative">
        <label for="assetNameInput">Asset name</label>
        <input type="text"
               class="form-control"
               id="assetNameInput"
               name="name"
               autocomplete="off"
               placeholder="Type to search fire protection assets…"
               required />
        <ul id="assetSuggestions"
            class="list-group shadow-sm"
            style="display:none; position:absolute; z-index:1000; width:100%; max-height:260px; overflow-y:auto"></ul>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Create asset</button>
</form>

<hr />

<h2>Contacts</h2>

@if (!Model.Contacts.Any())
{
    <p class="text-muted">No contacts for this property.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Ref</th>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Receives</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Contacts.OrderBy(c => !c.Active).ThenBy(c => c.Name))
                {
                    <tr class="@(c.Active ? "" : "text-muted")">
                        <td class="text-nowrap">@c.DisplayRef</td>
                        <td>
                            @c.Name
                            @if (!string.IsNullOrWhiteSpace(c.Organisation))
                            {
                                <div class="small text-muted">@c.Organisation</div>
                            }
                        </td>
                        <td>@c.Role</td>
                        <td>@c.Email</td>
                        <td class="text-nowrap">@c.Mobile</td>
                        <td>
                            @if (c.ReportRequired) { <span class="badge bg-light text-dark border me-1">Reports</span> }
                            @if (c.InvoiceRequired) { <span class="badge bg-light text-dark border me-1">Invoices</span> }
                            @if (c.QuoteRequired) { <span class="badge bg-light text-dark border me-1">Quotes</span> }
                            @if (c.NotificationRequired) { <span class="badge bg-light text-dark border me-1">Notifications</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<hr />

<h2>Defects</h2>

@if (!Model.Defects.Any())
{
    <p class="text-muted">No defects recorded for this property.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Ref</th>
                    <th>Raised</th>
                    <th>Type</th>
                    <th>Asset</th>
                    <th>Description</th>
                    <th>Severity</th>
                    <th>Status</th>
                    <th>Resolution</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Defects.OrderBy(d => !d.Active).ThenByDescending(d => d.RaisedUtc))
                {
                    <tr class="@(d.Active ? "" : "text-muted")">
                        <td class="text-nowrap">@d.DisplayRef</td>
                        <td class="text-nowrap">@d.RaisedUtc.ToSydney()?.ToString("dd/MM/yyyy")</td>
                        <td>@d.RemarkType</td>
                        <td>
                            @if (d.Asset != null)
                            {
                                <a asp-controller="Assets" asp-action="Details" asp-route-id="@d.Asset.Id">@d.Asset.Name</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(d.Location))
                            {
                                <div class="small text-muted">@d.Location</div>
                            }
                        </td>
                        <td>@d.Description</td>
                        <td>@(d.SeverityLabel ?? d.Severity?.ToString())</td>
                        <td>
                            @d.Status
                            @if (!string.IsNullOrWhiteSpace(d.QuoteRef))
                            {
                                <div class="small text-muted">Quote @d.QuoteRef @d.QuoteStatus</div>
                            }
                        </td>
                        <td>@d.Resolution</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<hr />

<h2>Service Reports</h2>

@if (!Model.ServiceReports.Any())
{
    <p class="text-muted">No service reports for this property.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Ref</th>
                    <th>Type</th>
                    <th>Inspected</th>
                    <th>Issued</th>
                    <th>Technician</th>
                    <th>Task</th>
                    <th>Compliant</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.ServiceReports.OrderByDescending(r => r.IssuedDate ?? r.InspectedDate))
                {
                    <tr>
                        <td class="text-nowrap">@r.DisplayRef</td>
                        <td>@r.ReportType</td>
                        <td class="text-nowrap">@r.InspectedDate?.ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">@r.IssuedDate?.ToString("dd/MM/yyyy")</td>
                        <td>@r.Technician</td>
                        <td>@r.TaskName</td>
                        <td>
                            @if (r.Compliant == true)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else if (r.Compliant == false)
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
(function () {
    const input = document.getElementById('assetNameInput');
    const list  = document.getElementById('assetSuggestions');
    if (!input || !list) return;

    let activeIndex = -1;
    let lastQuery   = '';
    let debounceTimer;

    function showSuggestions(items) {
        list.innerHTML = '';
        activeIndex = -1;

        if (!items.length) { list.style.display = 'none'; return; }

        items.forEach((name, i) => {
            const li = document.createElement('li');
            li.className = 'list-group-item list-group-item-action py-2';
            li.textContent = name;
            li.addEventListener('mousedown', e => {
                e.preventDefault();
                input.value = name;
                list.style.display = 'none';
            });
            list.appendChild(li);
        });

        list.style.display = 'block';
    }

    function setActive(index) {
        const items = list.querySelectorAll('.list-group-item');
        items.forEach((el, i) => el.classList.toggle('active', i === index));
        activeIndex = index;
    }

    input.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        const q = input.value.trim();
        if (q === lastQuery) return;
        lastQuery = q;

        if (!q) { list.style.display = 'none'; return; }

        debounceTimer = setTimeout(async () => {
            try {
                const res = await fetch(`/api/assets/suggestions?q=${encodeURIComponent(q)}`);
                const data = await res.json();
                showSuggestions(data);
            } catch { list.style.display = 'none'; }
        }, 150);
    });

    input.addEventListener('keydown', e => {
        const items = list.querySelectorAll('.list-group-item');
        if (!items.length) return;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            setActive(Math.min(activeIndex + 1, items.length - 1));
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            setActive(Math.max(activeIndex - 1, 0));
        } else if (e.key === 'Enter' && activeIndex >= 0) {
            e.preventDefault();
            input.value = items[activeIndex].textContent;
            list.style.display = 'none';
        } else if (e.key === 'Escape') {
            list.style.display = 'none';
        }
    });

    document.addEventListener('click', e => {
        if (!input.contains(e.target) && !list.contains(e.target))
            list.style.display = 'none';
    });
})();
</script>
}

<a asp-controller="Clients"
   asp-action="Details"
   asp-route-id="@Model.ClientId"
   class="btn btn-secondary">
    ← Back to Client
</a>
