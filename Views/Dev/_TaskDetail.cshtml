@using FyreApp.Models
@model ClientTask

<form asp-action="TaskUpdate" asp-controller="Dev" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Client</label>
            <input type="text" class="form-control form-control-sm" value="@Model.Client.Name" disabled />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Property</label>
            <input type="text" class="form-control form-control-sm" value="@(Model.Site?.Name ?? "—")" disabled />
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm" name="Title" value="@Model.Title" required maxlength="120" />
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold">Description</label>
            <textarea class="form-control form-control-sm" name="Description" rows="3" maxlength="4000">@Model.Description</textarea>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Status</label>
            <select class="form-select form-select-sm" name="Status">
                @foreach (var s in Enum.GetValues<ClientTaskStatus>())
                {
                    if (Model.Status == s)
                    {
                        <option value="@((int)s)" selected>@s</option>
                    }
                    else
                    {
                        <option value="@((int)s)">@s</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Priority</label>
            <select class="form-select form-select-sm" name="Priority">
                @foreach (var p in Enum.GetValues<ClientTaskPriority>())
                {
                    if (Model.Priority == p)
                    {
                        <option value="@((int)p)" selected>@p</option>
                    }
                    else
                    {
                        <option value="@((int)p)">@p</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Due Date</label>
            <input type="datetime-local" class="form-control form-control-sm" name="DueDateUtc"
                   value="@(Model.DueDateUtc.HasValue ? Model.DueDateUtc.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
        </div>

        <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top mt-1">
            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-primary">Save changes</button>
        </div>
    </div>
</form>
