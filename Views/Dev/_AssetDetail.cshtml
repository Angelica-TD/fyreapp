@model FyreApp.Models.Asset

<form asp-action="AssetUpdate" asp-controller="Dev" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Client</label>
            <input type="text" class="form-control form-control-sm" value="@Model.Site.Client.Name" disabled />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Property</label>
            <input type="text" class="form-control form-control-sm" value="@Model.Site.Name" disabled />
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm" name="Name" value="@Model.Name" required maxlength="200" />
        </div>

        <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top mt-1">
            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-primary">Save changes</button>
        </div>
    </div>
</form>
