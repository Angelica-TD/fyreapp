@model FyreApp.Models.Client

<form asp-action="ClientUpdate" asp-controller="Dev" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="row g-2">
        <div class="col-12"><h6 class="text-muted border-bottom pb-1 mb-1">General</h6></div>

        <div class="col-md-8">
            <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm" name="Name" value="@Model.Name" required maxlength="200" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">External ID</label>
            <input type="text" class="form-control form-control-sm" name="ExternalId" value="@Model.ExternalId" />
        </div>
        <div class="col-12">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="Active" value="true" id="clientActive" @(Model.Active ? "checked" : "") />
                <input type="hidden" name="Active" value="false" />
                <label class="form-check-label" for="clientActive">Active</label>
            </div>
        </div>

        <div class="col-12 mt-1"><h6 class="text-muted border-bottom pb-1 mb-1">Primary Contact</h6></div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Name</label>
            <input type="text" class="form-control form-control-sm" name="PrimaryContactName" value="@Model.PrimaryContactName" maxlength="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Mobile</label>
            <input type="text" class="form-control form-control-sm" name="PrimaryContactMobile" value="@Model.PrimaryContactMobile" maxlength="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Email</label>
            <input type="email" class="form-control form-control-sm" name="PrimaryContactEmail" value="@Model.PrimaryContactEmail" maxlength="320" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">CC Email</label>
            <input type="email" class="form-control form-control-sm" name="PrimaryContactCcEmail" value="@Model.PrimaryContactCcEmail" maxlength="320" />
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold">Address</label>
            <input type="text" class="form-control form-control-sm" name="PrimaryContactAddress" value="@Model.PrimaryContactAddress" />
        </div>

        <div class="col-12 mt-1"><h6 class="text-muted border-bottom pb-1 mb-1">Billing</h6></div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Billing Name</label>
            <input type="text" class="form-control form-control-sm" name="BillingName" value="@Model.BillingName" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Attention To</label>
            <input type="text" class="form-control form-control-sm" name="BillingAttentionTo" value="@Model.BillingAttentionTo" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Billing Email</label>
            <input type="email" class="form-control form-control-sm" name="BillingEmail" value="@Model.BillingEmail" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Billing CC Email</label>
            <input type="email" class="form-control form-control-sm" name="BillingCcEmail" value="@Model.BillingCcEmail" />
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold">Billing Address</label>
            <input type="text" class="form-control form-control-sm" name="BillingAddress" value="@Model.BillingAddress" />
        </div>

        <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top mt-1">
            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-primary">Save changes</button>
        </div>
    </div>
</form>
