<style>
    /* quick status styles */
    .fc-event.overdue {
        border-color: #b91c1c;
        background: #ef4444;
    }

    .fc-event.due {
        border-color: #b45309;
        background: #f59e0b;
    }
</style>

<div class="text-center">
    <h2 class="mt-3">Maintenance Calendar</h2>
    <div id="calendar" class="mt-3"></div>
</div>

<script src="~/lib/fullcalendar/dist/index.global.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const calendarEl = document.getElementById('calendar');

        if (!calendarEl) return;

        // A month grid is unreadable on a phone: there, the week as a list
        const phone = window.matchMedia('(max-width: 767.98px)').matches;
        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: phone ? 'listWeek' : 'dayGridMonth',
            headerToolbar: phone
                ? { left: 'title', right: 'prev,next' }
                : { left: 'title', right: 'today prev,next' },
            noEventsContent: 'Nothing due this week.',
            height: 'auto',
            eventDisplay: 'block',

            events: {
                url: '@Url.Action("MaintenanceEvents", "Home")',
                failure: function () {
                    alert('Failed to load maintenance events');
                }
            },

            eventClassNames: function (arg) {
                return arg.event.classNames;
            }
        });

        calendar.render();
    });
</script>
