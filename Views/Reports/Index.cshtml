@model FyreApp.ViewModels.Lists.ReportListVm

@{
    ViewData["Title"] = "Reports";
    var f = Model.Filter;
}

<div class="card">
    <div class="card-header">
        <h1 class="h4 m-0">Reports</h1>
    </div>

    <div class="card-body">
        <form method="get" asp-action="Index" class="mb-3">
            <input type="search" name="search" value="@f.Search" class="form-control" placeholder="Search ref, title, task, property or client" />
        </form>

        <p class="text-muted mb-2">@Model.Total.ToString("N0") report@(Model.Total == 1 ? "" : "s")</p>

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No reports match.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Ref</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Issued</th>
                            <th>Property</th>
                            <th>Client</th>
                            <th>Task</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td class="text-nowrap">@(r.Ref ?? "—")</td>
                                <td>@r.Title</td>
                                <td>
                                    @if (r.Compliant == true)
                                    {
                                        <span class="badge bg-success">PASS</span>
                                    }
                                    else if (r.Compliant == false)
                                    {
                                        <span class="badge bg-danger">FAIL</span>
                                    }
                                </td>
                                <td class="text-nowrap">@(r.Issued.ToDisplayDate() ?? "—")</td>
                                <td>
                                    <a asp-controller="Property" asp-action="Details" asp-route-id="@r.SiteId">@r.PropertyRef</a>
                                    <span class="text-muted">· @r.PropertyName</span>
                                </td>
                                <td>
                                    <a asp-controller="Clients" asp-action="Details" asp-route-id="@r.ClientId">@r.ClientName</a>
                                    @if (!string.IsNullOrWhiteSpace(r.ClientContact))
                                    {
                                        <span class="text-muted">· @r.ClientContact</span>
                                    }
                                </td>
                                <td class="text-nowrap">@r.TaskRef</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_ListPager", (f.Page, Model.Pages))
        }
    </div>
</div>
