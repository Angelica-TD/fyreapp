@model FyreApp.Models.MaintenanceSchedule
@using FyreApp.Models

@{
    ViewData["Title"] = "Schedule Details";
    var isAsset = Model.TargetType == ScheduleTargetType.Asset;
    var client = isAsset ? Model.Asset?.Site?.Client : Model.Site?.Client;
    var targetName = isAsset ? $"{Model.Asset?.Site?.Name} • {Model.Asset?.Name}" : Model.Site?.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="MaintenanceSchedules" asp-action="Index">Schedules</a>
        </li>
        <li class="breadcrumb-item active">@targetName</li>
    </ol>
</nav>

<h1>
    @targetName
    @if (Model.DisplayRef != null)
    {
        <span class="badge bg-light text-dark border align-middle">@Model.DisplayRef</span>
    }
</h1>

<p class="text-muted">
    @client?.Name
    @if (isAsset)
    {
        <text> — </text>
        <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId">View asset</a>
    }
    else
    {
        <text> — </text>
        <a asp-controller="Property" asp-action="Details" asp-route-id="@Model.SiteId">View property</a>
    }
</p>

@if (Model.RoutineLevels.Any())
{
    <h2 class="h5 mt-3">Uptick routines</h2>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Routine</th>
                <th>Level</th>
                <th>Standard</th>
                <th>Tolerance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var level in Model.RoutineLevels.OrderBy(l => l.RoutineServiceType.Name))
            {
                <tr>
                    <td>@level.RoutineServiceType.Name</td>
                    <td>@level.Name</td>
                    <td class="text-muted">@level.RoutineServiceType.StandardReference</td>
                    <td class="text-muted">
                        @if (level.ToleranceInterval.HasValue)
                        {
                            @($"± {level.ToleranceInterval} {(level.ToleranceUnit == "D" ? "days" : "months")}")
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

@await Html.PartialAsync("~/Views/MaintenanceSchedules/_ScheduleForm.cshtml", Model)

<hr />

<a asp-action="Index" class="btn btn-secondary">← Back to Schedules</a>
