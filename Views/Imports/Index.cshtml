@model FyreApp.ViewModels.Imports.UptickImportResultVm?
@using FyreApp.Services.Imports

@{
    ViewData["Title"] = "Import from Uptick";
    var selected = ViewData["SelectedType"] as UptickExportType?;
    var resetEnabled = ViewData["ResetEnabled"] as bool? ?? false;

    string Label(UptickExportType t) => t switch
    {
        UptickExportType.PropertyContacts => "Property contacts",
        UptickExportType.AssetTypes => "Asset types",
        UptickExportType.AssetTypeVariants => "Asset type variants",
        UptickExportType.RemarkTypes => "Remark types",
        UptickExportType.RoutineServiceTypes => "Routine service types",
        UptickExportType.RoutineServiceLevels => "Routine service levels (level types)",
        _ => t.ToString()
    };
}

<h1 class="m-0 mb-3">Import from Uptick</h1>

<div class="row g-4">
    <div class="col-lg-4 order-lg-2">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Import order</h2>
                <p class="small text-muted mb-2">Each export matches records imported by the step before it.</p>
                <ol class="small mb-0 ps-3">
                    <li>Reference data: asset types, asset type variants, remark types, routine service types, routine service levels</li>
                    <li><a asp-controller="Clients" asp-action="Import">Clients</a></li>
                    <li>Properties</li>
                    <li>Property contacts</li>
                    <li>Assets</li>
                    <li><a asp-controller="MaintenanceSchedules" asp-action="Import">Routine schedules</a></li>
                    <li>Remarks (after assets, so they link to the asset)</li>
                    <li>Reports</li>
                    <li>Tasks (after routine schedules, so routine tasks link to them)</li>
                </ol>
                <p class="small text-muted mt-2 mb-0">
                    You can export everything from Uptick and import it again: records already in FyreApp (same Uptick ID)
                    are skipped and only new ones are added.
                </p>
                <ul class="small text-muted mt-1 mb-0 ps-3">
                    <li>Reference data is refreshed from the export, so fixes made in Uptick come through.</li>
                    <li>Routines only move forward (pending → task raised → complete): completions in Uptick come through, tasks raised in FyreApp are kept.</li>
                </ul>
                <p class="small text-muted mt-2 mb-0">
                    In Uptick, include <strong>inactive / archived</strong> records when exporting clients and properties.
                    Otherwise records that refer to them get inactive <em>placeholder</em> clients and properties, which are
                    filled in when an export containing them is imported.
                </p>
            </div>
        </div>

        <div class="card mt-3 @(resetEnabled ? "border-danger" : "")">
            <div class="card-body">
                <h2 class="h6">Start fresh</h2>
                <p class="small mb-2">
                    Data reset is
                    @if (resetEnabled)
                    {
                        <span class="badge bg-danger">enabled</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">disabled</span>
                    }
                </p>
                <a asp-controller="DataReset" asp-action="Index" class="small">Data reset</a>
            </div>
        </div>
    </div>

    <div class="col-lg-8 order-lg-1">
        <form method="post" enctype="multipart/form-data" asp-action="Index">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label" for="type">Export</label>
                <select name="type" id="type" class="form-select">
                    <option value="">Detect from columns</option>
                    @foreach (var t in Enum.GetValues<UptickExportType>())
                    {
                        <option value="@t" selected="@(selected == t ? "selected" : null)">@Label(t)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="file">CSV or XLSX file</label>
                <input type="file" name="file" id="file" class="form-control" accept=".csv,.txt,.xlsx" data-max-bytes="@ImportLimits.MaxUploadBytes" required />
                @Html.ValidationMessage("file", null, new { @class = "text-danger" })
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="dryRun" id="dryRun" value="true" checked />
                <label class="form-check-label" for="dryRun">Dry-run (preview only, don't save)</label>
            </div>

            <button type="submit" class="btn btn-primary">Upload</button>
        </form>

        @if (Model != null)
        {
            <hr />

            if (Model.Error != null)
            {
                <div class="alert alert-danger mb-0">
                    @Model.Error
                    <div class="small text-muted mt-1">@Model.FileName</div>
                </div>
            }
            else
            {
                <div class="alert @(Model.DryRun ? "alert-info" : "alert-success")">
                    <strong>
                        @(Model.Type.HasValue ? Label(Model.Type.Value) : "")
                        @(Model.DryRun ? "dry-run complete. Nothing was saved." : "import complete.")
                    </strong>
                    <span class="text-muted small ms-2">@Model.FileName</span>
                    <ul class="mb-0 mt-2">
                        <li>Rows read: <strong>@Model.TotalRows</strong></li>
                        <li>@(Model.DryRun ? "To create" : "Created"): <strong>@Model.Created</strong></li>
                        <li>Already imported (skipped): <strong>@Model.SkippedExisting</strong></li>
                        @foreach (var (reason, count) in Model.Skipped.OrderByDescending(s => s.Value))
                        {
                            <li>Skipped: @reason: <strong>@count</strong></li>
                        }
                        @foreach (var note in Model.Notes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>

                if (Model.Issues.Any())
                {
                    <h2 class="h5">Issues</h2>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Type</th><th>Key</th><th>Message</th><th>Rows</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var issue in Model.Issues)
                                {
                                    <tr>
                                        <td class="text-nowrap">@issue.Type</td>
                                        <td>@issue.Key</td>
                                        <td>@issue.Message</td>
                                        <td class="small">@string.Join(", ", issue.Rows)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    </div>
</div>
