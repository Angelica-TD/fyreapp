@model FyreApp.Models.Asset

@{
    ViewData["Title"] = "Asset Details";
    var schedule = Model.MaintenanceSchedules?.FirstOrDefault() ?? new FyreApp.Models.MaintenanceSchedule
    {
        TargetType = FyreApp.Models.ScheduleTargetType.Asset,
        AssetId = Model.Id,
        StartDate = DateTime.UtcNow
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.Site.Client.Id">@Model.Site.Client.Name</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="Property" asp-action="Details" asp-route-id="@Model.SiteId">@Model.Site.Name</a>
        </li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<h1>@Model.Name</h1>

@if (Model.AssetTypes.Any())
{
    <div class="d-flex flex-wrap gap-1 mb-3">
        @foreach (var type in Model.AssetTypes)
        {
            <span class="badge bg-secondary">@type.Name</span>
        }
    </div>
}

@{
    var details = new (string Label, string? Value)[]
    {
        ("Ref", Model.DisplayRef),
        ("Status", Model.IsActive ? "Active" : "Inactive"),
        ("Asset no.", Model.Ref),
        ("Location", Model.Location),
        ("Variant", Model.Variant),
        ("Make", Model.Make),
        ("Model", Model.Model),
        ("Size", Model.Size),
        ("Barcode", Model.Barcode),
        ("Last result", Model.Compliance),
        ("Base date", Model.BaseDate.ToDisplayDate()),
        ("Installed", Model.InstallationDate.ToDisplayDate()),
        ("Last service", Model.LastServiceDate.ToDisplayDate())
    }.Where(d => !string.IsNullOrWhiteSpace(d.Value)).ToList();
}

@if (details.Count > 1)
{
    <dl class="row mb-0" style="max-width: 40rem;">
        @foreach (var (label, value) in details)
        {
            <dt class="col-sm-4">@label</dt>
            <dd class="col-sm-8">@value</dd>
        }
    </dl>
}

<div style="max-width: 40rem;">
    @await Html.PartialAsync("_UptickData", Model.UptickData)
</div>

@if (Model.Defects.Any())
{
    <hr />
    <h2 class="h5">Defects</h2>
    <ul>
        @foreach (var d in Model.Defects.OrderByDescending(d => d.RaisedUtc))
        {
            <li>
                <span class="text-muted">@d.DisplayRef</span>
                <strong>@d.RemarkType</strong>: @d.Description
                <span class="text-muted">(@d.Status@(string.IsNullOrWhiteSpace(d.Resolution) ? "" : $", {d.Resolution}"))</span>
            </li>
        }
    </ul>
}

<hr />

@await Html.PartialAsync("~/Views/MaintenanceSchedules/_ScheduleForm.cshtml", schedule)

<hr />

<a asp-controller="Property" asp-action="Details" asp-route-id="@Model.SiteId" class="btn btn-secondary">
    ← Back to Property
</a>
