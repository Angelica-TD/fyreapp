@model FyreApp.ViewModels.Assets.AssetEditVm

@* Uptick's asset Update form: fields in Uptick's order and wording *@
@{
    var a = Model.Asset!;
    var site = a.Site;
    ViewData["Title"] = $"Update {a.Name}";
}

<div class="property-page">
    <h1 class="property-title">
        @if (site.DisplayRef != null)
        {
            <span class="property-title-ref">@site.DisplayRef</span>
        }
        <span class="property-title-name">@site.Name</span>
    </h1>

    <div class="card property-card asset-form">
        <div class="card-header"><span>@a.Name</span></div>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger px-3 pt-3"></div>

            <div class="card-body">
                <div class="row mb-3">
                    <label asp-for="AssetTypeId" class="col-sm-4 col-form-label text-sm-end">Type <span class="text-danger">*</span></label>
                    <div class="col-sm-8">
                        <select asp-for="AssetTypeId" class="form-select" id="assetType">
                            <option value="">Select…</option>
                            @foreach (var (id, name) in Model.AssetTypes)
                            {
                                <option value="@id" selected="@(Model.AssetTypeId == id)">@name</option>
                            }
                        </select>
                        <div class="form-text">Changing the Asset Type will reset the Variant.</div>
                        <span asp-validation-for="AssetTypeId" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="AssetTypeVariantId" class="col-sm-4 col-form-label text-sm-end">Variant</label>
                    <div class="col-sm-8">
                        <select asp-for="AssetTypeVariantId" class="form-select" id="assetVariant">
                            @* An imported variant FyreApp has no record of stays as it is unless another is picked *@
                            <option value="">@(a.AssetTypeVariantId == null && a.Variant != null ? $"{a.Variant} (as imported)" : "-")</option>
                            @foreach (var (id, typeId, name) in Model.Variants)
                            {
                                <option value="@id" data-type="@typeId" selected="@(Model.AssetTypeVariantId == id)"
                                        hidden="@(typeId != Model.AssetTypeId)">@name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Location" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="Location" class="form-control" />
                        <div class="form-text">Where is the asset located? Use commas to build a location hierarchy e.g. "Building 2B, Floor 6, Unit 3"</div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Label" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="Label" class="form-control" />
                        <div class="form-text">Leave blank to use the asset type and variant.</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-8 offset-sm-4">
                        <div class="form-check">
                            <input asp-for="Active" class="form-check-input" />
                            <label asp-for="Active" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body border-top">
                <div class="row mb-3">
                    <label asp-for="Ref" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="Ref" class="form-control" />
                        <div class="form-text">Internal reference (e.g. door number).</div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Serial" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="Serial" class="form-control" />
                        <div class="form-text">External inspection reference or serial (e.g. fire door certification tag).</div>
                    </div>
                </div>
                <div class="row">
                    <label asp-for="Barcode" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8"><input asp-for="Barcode" class="form-control" /></div>
                </div>
            </div>

            <div class="card-body border-top">
                <div class="row mb-3">
                    <label asp-for="BaseDate" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="BaseDate" type="date" class="form-control" value="@Model.BaseDate?.ToString("yyyy-MM-dd")" />
                        <div class="form-text">The base date for major servicing calculations.</div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="InstallationDate" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="InstallationDate" type="date" class="form-control" value="@Model.InstallationDate?.ToString("yyyy-MM-dd")" />
                        <div class="form-text">The date the item was installed, for lifecycle maintenance reporting.</div>
                    </div>
                </div>
                <div class="row">
                    <label asp-for="InspectionOrder" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8"><input asp-for="InspectionOrder" class="form-control" /></div>
                </div>
            </div>

            <div class="card-body border-top">
                <div class="row mb-3">
                    <label asp-for="InternalNote" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8"><textarea asp-for="InternalNote" class="form-control" rows="3"></textarea></div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Make" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="Make" class="form-control" />
                        <div class="form-text">If applicable, the Make of this asset.</div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Model" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="Model" class="form-control" />
                        <div class="form-text">If applicable, the Model of this asset.</div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Size" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="Size" class="form-control" />
                        <div class="form-text">If applicable, the Size of this asset.</div>
                    </div>
                </div>
                <div class="row">
                    <label asp-for="Quantity" class="col-sm-4 col-form-label text-sm-end"></label>
                    <div class="col-sm-8">
                        <input asp-for="Quantity" class="form-control" />
                        <div class="form-text">Information for office staff only.</div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
                <a class="btn btn-light border" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                <button type="submit" name="continueEditing" value="true" class="btn btn-light border">Save and continue editing</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Changing the type resets the variant and shows only that type's variants
        (function () {
            const type = document.getElementById('assetType');
            const variant = document.getElementById('assetVariant');
            type.addEventListener('change', function () {
                variant.value = '';
                for (const o of variant.options) {
                    if (o.dataset.type) o.hidden = o.dataset.type !== type.value;
                }
            });
        })();
    </script>
}
