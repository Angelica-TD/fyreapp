@model FyreApp.ViewModels.Lists.DirectoryListVm<FyreApp.Models.Contractor>

@{
    ViewData["Title"] = "Contractors";
    var f = Model.Filter;
}

<div class="card">
    <div class="card-header">
        <h1 class="h4 m-0">Contractors</h1>
    </div>

    <div class="card-body">
        @await Html.PartialAsync("_DirectoryFilters", (f, "Search name, contact, email or category"))

        @await Html.PartialAsync("_SelectionToolbar", new FyreApp.ViewModels.Lists.SelectionToolbarVm
        {
            Total = Model.Total, PageCount = Model.Items.Count, Noun = "Contractors", NounSingular = "Contractor",
            DownloadUrl = Url.Action("Download") + "?" + FyreApp.ViewModels.Lists.FilterQuery.ToQueryString(f.QueryValues())
        })

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No contractors match. Contractors come from Uptick, brought in by the Uptick migration.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Primary contact</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Mobile</th>
                            <th>Service areas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Items)
                        {
                            <tr class="@(c.Active ? "" : "text-muted")">
                                <td>
                                    @if (c.Starred) { <i class="bi bi-star-fill text-warning" title="Starred"></i> }
                                    @c.Name
                                    @if (!c.Active) { <span class="badge bg-secondary">Inactive</span> }
                                </td>
                                <td>@(c.Category ?? "-")</td>
                                <td>@(c.PrimaryContact ?? "-")</td>
                                <td>
                                    @if (c.Email != null) { <a href="mailto:@c.Email">@c.Email</a> } else { <text>-</text> }
                                    @if (c.EmailCc != null) { <div class="small text-muted" style="white-space: pre-line">Cc: @c.EmailCc</div> }
                                </td>
                                <td class="text-nowrap">@(c.Phone ?? "-")</td>
                                <td class="text-nowrap">@(c.Mobile ?? "-")</td>
                                <td>@(c.ServiceAreas ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_ListPager", (f.Page, Model.Pages))
        }
    </div>
</div>
