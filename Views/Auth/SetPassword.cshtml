@model FyreApp.ViewModels.Auth.SetPasswordVm

@{
    ViewData["Title"] = "Set your password";
}

<div class="mt-5">
    <div class="container" style="max-width: 420px;">
        <h2 class="text-center">Set your password</h2>

        @if (Model.Expired)
        {
            <div class="alert alert-warning mt-3">
                This link has expired or has already been used. Ask an admin to send you a new one from the Users page.
            </div>
            <a href="/" class="btn btn-outline-secondary">Go to sign in</a>
        }
        else
        {
            <p class="text-muted text-center">You'll sign in to FyreApp with <strong>@Model.Email</strong>.</p>

            <form asp-action="SetPassword" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <div class="form-text">At least 8 characters, with an uppercase letter, a number and a special character.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Set password</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
