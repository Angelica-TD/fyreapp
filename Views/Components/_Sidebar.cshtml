@* The app's navigation (desktop sidebar and mobile offcanvas). Everyday pages sit at the top; the rest are in
   collapsible groups, as Uptick's sidebar has them. The group holding the current page is always open; others
   remember being opened (site.js). In the icon-only sidebar the group headings hide and every link shows. *@
@{
    var isAdmin = User.IsInRole("Admin");
    var isDev = User.IsInRole("Developer");
    var current = ViewContext.RouteData.Values["controller"]?.ToString();

    // (controller, label, icon, shown)
    var groups = new (string Key, string Label, string Icon, (string Controller, string Label, string Icon, bool Show)[] Items)[]
    {
        ("customer-data", "Customer data", "bi-buildings", new[]
        {
            ("Clients", "Clients", "bi-people-fill", true),
            ("Property", "Properties", "bi-building", isAdmin),
            ("Assets", "Assets", "bi-fire", isAdmin),
            ("Remarks", "Remarks", "bi-exclamation-triangle", isAdmin),
            ("Reports", "Reports", "bi-file-earmark-check", isAdmin),
            ("Correspondence", "Correspondence", "bi-envelope", isAdmin),
            ("MaintenanceSchedules", "Schedules", "bi-calendar2-check-fill", isAdmin && UiFeatures.MaintenanceSchedules)
        }),
        ("people", "People", "bi-person-lines-fill", new[]
        {
            ("Users", "Users", "bi-shield-lock-fill", isAdmin),
            ("Contractors", "Contractors", "bi-person-badge", isAdmin),
            ("Suppliers", "Suppliers", "bi-truck", isAdmin)
        }),
        ("catalogue", "Catalogue", "bi-grid-fill", new[]
        {
            ("ServiceOfferings", "Services", "bi-tools", isAdmin || isDev),
            ("Products", "Products", "bi-box-seam", isAdmin)
        }),
        ("admin", "Admin", "bi-gear-fill", new[]
        {
            ("UptickMigration", "Uptick migration", "bi-cloud-download-fill", isAdmin),
            ("Dev", "Dev Tools", "bi-bug-fill", isDev),
            ("DataReset", "Data Reset", "bi-exclamation-octagon-fill", isDev)
        })
    };
}
<nav class="sidebar-nav">
    <ul class="nav nav-pills flex-column gap-1">

        <li class="nav-item text-end">
            @* Desktop sidebar toggle: visible only at lg+ *@
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <button id="sidebarToggle"
                            class="btn btn-sm btn-ghost d-none d-lg-inline-flex align-items-center"
                            aria-label="Toggle sidebar"
                            title="Toggle sidebar">
                        <i class="bi bi-layout-sidebar"></i>
                    </button>
                }
        </li>

        <!-- Home -->
        <li class="nav-item">
            <a class="nav-link sidebar-link"
               asp-controller="Home"
               asp-action="Index"
               nav-active>
                <i class="bi bi-house-door-fill sidebar-icon"></i>
                <span class="sidebar-label">Home</span>
            </a>
        </li>

        <!-- Tasks -->
        <li class="nav-item has-subnav">
            <a class="nav-link sidebar-link"
               asp-controller="Task"
               asp-action="Index"
               nav-active
               nav-active-controller-only>
                <i class="bi bi-check2-square sidebar-icon"></i>
                <span class="sidebar-label">Tasks</span>
            </a>
            <ul class="nav flex-column sub-nav ps-4 mt-1">
                @if (isAdmin)
                {
                    <!-- Routines: Uptick routine occurrences, under Tasks as in Uptick (Admin only) -->
                    <li class="nav-item">
                        <a class="nav-link sidebar-link sidebar-sublink"
                           asp-controller="Routines"
                           asp-action="Index"
                           nav-active
                           nav-active-controller-only>
                            <i class="bi bi-arrow-repeat sidebar-icon"></i>
                            <span class="sidebar-label">Routines</span>
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link sidebar-link sidebar-sublink"
                       asp-controller="Task"
                       asp-action="Create">
                        <i class="bi bi-plus-circle sidebar-icon"></i>
                        <span class="sidebar-label">Add new</span>
                    </a>
                </li>
            </ul>
        </li>

        <!-- Quotes -->
        <li class="nav-item">
            <a class="nav-link sidebar-link"
               asp-controller="Quotes"
               asp-action="Index"
               nav-active
               nav-active-controller-only>
                <i class="bi bi-file-earmark-text-fill sidebar-icon"></i>
                <span class="sidebar-label">Quotes</span>
            </a>
        </li>

        @foreach (var group in groups)
        {
            var items = group.Items.Where(i => i.Show).ToList();
            if (items.Count == 0) continue;
            var holdsCurrent = items.Any(i => string.Equals(i.Controller, current, StringComparison.OrdinalIgnoreCase));

            <li class="nav-item sidebar-group @(holdsCurrent ? "open current" : "")" data-group="@group.Key">
                <button type="button" class="nav-link sidebar-link sidebar-group-toggle btn btn-link text-start w-100"
                        aria-expanded="@(holdsCurrent ? "true" : "false")">
                    <i class="bi @group.Icon sidebar-icon"></i>
                    <span class="sidebar-label">@group.Label</span>
                    <i class="bi bi-chevron-down sidebar-label sidebar-chevron ms-auto"></i>
                </button>
                <ul class="nav flex-column sidebar-group-items">
                    @foreach (var item in items)
                    {
                        <li class="nav-item">
                            <a class="nav-link sidebar-link sidebar-grouplink"
                               asp-controller="@item.Controller"
                               asp-action="Index"
                               nav-active
                               nav-active-controller-only
                               title="@item.Label">
                                <i class="bi @item.Icon sidebar-icon"></i>
                                <span class="sidebar-label">@item.Label</span>
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }

        <!-- Change Password (all users) -->
        <li class="nav-item mt-auto">
            <a class="nav-link sidebar-link"
               asp-controller="Auth"
               asp-action="ChangePassword"
               nav-active>
                <i class="bi bi-key-fill sidebar-icon"></i>
                <span class="sidebar-label">Change Password</span>
            </a>
        </li>

    </ul>
</nav>
