<nav class="sidebar-nav">
    <ul class="nav nav-pills flex-column gap-1">

        <li class="nav-item text-end">
            @* Desktop sidebar toggle: visible only at lg+ *@
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <button id="sidebarToggle"
                            class="btn btn-sm btn-ghost d-none d-lg-inline-flex align-items-center"
                            aria-label="Toggle sidebar"
                            title="Toggle sidebar">
                        <i class="bi bi-layout-sidebar"></i>
                    </button>
                }
        </li>

        <!-- Home -->
        <li class="nav-item">
            <a class="nav-link sidebar-link"
               asp-controller="Home"
               asp-action="Index"
               nav-active>
                <i class="bi bi-house-door-fill sidebar-icon"></i>
                <span class="sidebar-label">Home</span>
            </a>
        </li>

        <!-- Clients -->
        <li class="nav-item has-subnav">
            <a class="nav-link sidebar-link"
               asp-controller="Clients"
               asp-action="Index"
               nav-active
               nav-active-controller-only>
                <i class="bi bi-people-fill sidebar-icon"></i>
                <span class="sidebar-label">Clients</span>
            </a>
            <ul class="nav flex-column sub-nav ps-4 mt-1">
                <li class="nav-item">
                    <button type="button"
                            class="nav-link sidebar-link sidebar-sublink btn btn-link text-start w-100"
                            data-bs-toggle="modal"
                            data-bs-target="#createClientModal">
                        <i class="bi bi-plus-circle sidebar-icon"></i>
                        <span class="sidebar-label">Add new</span>
                    </button>
                </li>
            </ul>
        </li>

        <!-- Quotes -->
        <li class="nav-item">
            <a class="nav-link sidebar-link"
               asp-controller="Quotes"
               asp-action="Index"
               nav-active
               nav-active-controller-only>
                <i class="bi bi-file-earmark-text-fill sidebar-icon"></i>
                <span class="sidebar-label">Quotes</span>
            </a>
        </li>

        <!-- Tasks -->
        <li class="nav-item has-subnav">
            <a class="nav-link sidebar-link"
               asp-controller="Task"
               asp-action="Index"
               nav-active
               nav-active-controller-only>
                <i class="bi bi-check2-square sidebar-icon"></i>
                <span class="sidebar-label">Tasks</span>
            </a>
            <ul class="nav flex-column sub-nav ps-4 mt-1">
                <li class="nav-item">
                    <a class="nav-link sidebar-link sidebar-sublink"
                       asp-controller="Task"
                       asp-action="Create">
                        <i class="bi bi-plus-circle sidebar-icon"></i>
                        <span class="sidebar-label">Add new</span>
                    </a>
                </li>
            </ul>
        </li>

        @if (User.IsInRole("Admin") || User.IsInRole("Developer"))
        {
            <!-- Service Offerings (Admin + Developer) -->
            <li class="nav-item has-subnav">
                <a class="nav-link sidebar-link"
                   asp-controller="ServiceOfferings"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-tools sidebar-icon"></i>
                    <span class="sidebar-label">Services</span>
                </a>
                <ul class="nav flex-column sub-nav ps-4 mt-1">
                    <li class="nav-item">
                        <a class="nav-link sidebar-link sidebar-sublink"
                           asp-controller="ServiceOfferings"
                           asp-action="Create">
                            <i class="bi bi-plus-circle sidebar-icon"></i>
                            <span class="sidebar-label">Add new</span>
                        </a>
                    </li>
                </ul>
            </li>
        }

        @if (User.IsInRole("Developer"))
        {
            <!-- Dev Tools -->
            <li class="nav-item">
                <a class="nav-link sidebar-link"
                   asp-controller="Dev"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-bug-fill sidebar-icon"></i>
                    <span class="sidebar-label">Dev Tools</span>
                </a>
            </li>

            <!-- Data reset toggle -->
            <li class="nav-item">
                <a class="nav-link sidebar-link"
                   asp-controller="DataReset"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-exclamation-octagon-fill sidebar-icon"></i>
                    <span class="sidebar-label">Data Reset</span>
                </a>
            </li>
        }

        @if (User.IsInRole("Admin"))
        {
            <!-- Properties (Admin only) -->
            <li class="nav-item">
                <a class="nav-link sidebar-link"
                   asp-controller="Property"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-building sidebar-icon"></i>
                    <span class="sidebar-label">Properties</span>
                </a>
            </li>

            <!-- Remarks / defects (Admin only) -->
            <li class="nav-item">
                <a class="nav-link sidebar-link"
                   asp-controller="Remarks"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-exclamation-triangle sidebar-icon"></i>
                    <span class="sidebar-label">Remarks</span>
                </a>
            </li>

            <!-- Reports (Admin only) -->
            <li class="nav-item">
                <a class="nav-link sidebar-link"
                   asp-controller="Reports"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-file-earmark-check sidebar-icon"></i>
                    <span class="sidebar-label">Reports</span>
                </a>
            </li>

            <!-- Assets (Admin only) -->
            <li class="nav-item">
                <a class="nav-link sidebar-link"
                   asp-controller="Assets"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-fire sidebar-icon"></i>
                    <span class="sidebar-label">Assets</span>
                </a>
            </li>

            <!-- Routines: Uptick routine occurrences (Admin only) -->
            <li class="nav-item">
                <a class="nav-link sidebar-link"
                   asp-controller="Routines"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-arrow-repeat sidebar-icon"></i>
                    <span class="sidebar-label">Routines</span>
                </a>
            </li>

            <!-- Schedules (Admin only) -->
            <li class="nav-item">
                <a class="nav-link sidebar-link"
                   asp-controller="MaintenanceSchedules"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-calendar2-check-fill sidebar-icon"></i>
                    <span class="sidebar-label">Schedules</span>
                </a>
            </li>

            <!-- Uptick import (Admin only) -->
            <li class="nav-item">
                <a class="nav-link sidebar-link"
                   asp-controller="Imports"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-cloud-upload-fill sidebar-icon"></i>
                    <span class="sidebar-label">Import</span>
                </a>
            </li>

            <!-- Users (Admin only) -->
            <li class="nav-item has-subnav">
                <a class="nav-link sidebar-link"
                   asp-controller="Users"
                   asp-action="Index"
                   nav-active
                   nav-active-controller-only>
                    <i class="bi bi-shield-lock-fill sidebar-icon"></i>
                    <span class="sidebar-label">Users</span>
                </a>
                <ul class="nav flex-column sub-nav ps-4 mt-1">
                    <li class="nav-item">
                        <a class="nav-link sidebar-link sidebar-sublink"
                           asp-controller="Users"
                           asp-action="Create">
                            <i class="bi bi-plus-circle sidebar-icon"></i>
                            <span class="sidebar-label">Add new</span>
                        </a>
                    </li>
                </ul>
            </li>
        }

        <!-- Change Password (all users) -->
        <li class="nav-item mt-auto">
            <a class="nav-link sidebar-link"
               asp-controller="Auth"
               asp-action="ChangePassword"
               nav-active>
                <i class="bi bi-key-fill sidebar-icon"></i>
                <span class="sidebar-label">Change Password</span>
            </a>
        </li>

    </ul>
</nav>
