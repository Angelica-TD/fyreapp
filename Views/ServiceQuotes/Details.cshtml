@model FyreApp.ViewModels.ServiceQuotes.ServiceQuoteDetailsVm
@using FyreApp.Models

@{
    ViewData["Title"] = $"Quote {Model.Quote.QuoteNumber}";
}

<div class="d-flex justify-content-between align-items-start">
    <div>
        <h1 class="m-0">@Model.Quote.QuoteNumber</h1>
        <p class="text-muted mb-0">
            <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.Quote.ClientId">
                @Model.Quote.Client?.Name
            </a>
        </p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#editQuoteModal">
                <i class="bi bi-pencil"></i> Edit
            </button>
            <form asp-action="Delete" asp-route-id="@Model.Quote.Id" method="post"
                  onsubmit="return confirm('Delete this quote? This cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </form>
        </div>
    }
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success">@successMsg</div>
}

@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger">@errorMsg</div>
}

<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="text-muted small">Title</div>
                <div>@Model.Quote.Title</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Status</div>
                <div>
                    <span class="badge @StatusBadgeClass(Model.Quote.Status)">@Model.Quote.Status</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Amount</div>
                <div class="fw-semibold">@Model.Quote.Amount.ToString("C")</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Quote.Description))
            {
                <div class="col-12">
                    <div class="text-muted small">Description</div>
                    <div class="white-space-pre-line">@Model.Quote.Description</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Quote.Notes))
            {
                <div class="col-12">
                    <div class="text-muted small">Notes</div>
                    <div class="white-space-pre-line">@Model.Quote.Notes</div>
                </div>
            }
            <div class="col-md-4">
                <div class="text-muted small">Expiry Date</div>
                <div>@(Model.Quote.ExpiryDate.HasValue ? Model.Quote.ExpiryDate.Value.ToString("dd MMM yyyy") : "—")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Created</div>
                <div>@Model.Quote.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</div>
            </div>
            @if (Model.Quote.UpdatedUtc.HasValue)
            {
                <div class="col-md-4">
                    <div class="text-muted small">Last Updated</div>
                    <div>@Model.Quote.UpdatedUtc.Value.ToString("dd MMM yyyy HH:mm") UTC</div>
                </div>
            }
        </div>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <!-- Edit Modal -->
    <div class="modal fade" id="editQuoteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="Update" asp-route-id="@Model.Quote.Id" asp-controller="ServiceQuotes" method="post">
                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <h5 class="modal-title">Edit Quote</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="Edit.Title" class="form-label">Title</label>
                            <input asp-for="Edit.Title" class="form-control" />
                            <span asp-validation-for="Edit.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Edit.Description" class="form-label">Description</label>
                            <textarea asp-for="Edit.Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Edit.Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Edit.Status" class="form-label">Status</label>
                                <select asp-for="Edit.Status"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<FyreApp.Models.ServiceQuoteStatus>()">
                                </select>
                                <span asp-validation-for="Edit.Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Edit.Amount" class="form-label">Amount ($)</label>
                                <input asp-for="Edit.Amount" class="form-control" type="number" min="0" step="0.01" />
                                <span asp-validation-for="Edit.Amount" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Edit.ExpiryDate" class="form-label">Expiry Date</label>
                                <input asp-for="Edit.ExpiryDate" class="form-control" type="date" />
                                <span asp-validation-for="Edit.ExpiryDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Edit.Notes" class="form-label">Notes</label>
                            <textarea asp-for="Edit.Notes" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Edit.Notes" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@functions {
    string StatusBadgeClass(ServiceQuoteStatus status) => status switch
    {
        ServiceQuoteStatus.Draft    => "bg-secondary",
        ServiceQuoteStatus.Sent     => "bg-info text-dark",
        ServiceQuoteStatus.Accepted => "bg-success",
        ServiceQuoteStatus.Declined => "bg-danger",
        ServiceQuoteStatus.Expired  => "bg-warning text-dark",
        _                           => "bg-secondary"
    };
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    @if (Model.OpenEdit)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                new bootstrap.Modal(document.getElementById("editQuoteModal")).show();
            });
        </script>
    }
}
