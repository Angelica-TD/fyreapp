@model FyreApp.ViewModels.ServiceQuotes.ServiceQuoteIndexVm

<div class="modal fade" id="createQuoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" asp-controller="ServiceQuotes" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">New Service Quote</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    @if (TempData["Error"] is string errMsg)
                    {
                        <div class="alert alert-danger">@errMsg</div>
                    }

                    <div class="mb-3">
                        <label asp-for="Create.ClientId" class="form-label">Client</label>
                        <select asp-for="Create.ClientId"
                                class="form-select"
                                asp-items="@(new SelectList(Model.Clients, "Id", "Name"))">
                            <option value="">-- Select client --</option>
                        </select>
                        <span asp-validation-for="Create.ClientId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Create.Title" class="form-label">Title</label>
                        <input asp-for="Create.Title" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Create.Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Create.Description" class="form-label">Description</label>
                        <textarea asp-for="Create.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Create.Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Create.Amount" class="form-label">Amount ($)</label>
                            <input asp-for="Create.Amount" class="form-control" type="number" min="0" step="0.01" />
                            <span asp-validation-for="Create.Amount" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Create.ExpiryDate" class="form-label">Expiry Date</label>
                            <input asp-for="Create.ExpiryDate" class="form-control" type="date" />
                            <span asp-validation-for="Create.ExpiryDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Create.Notes" class="form-label">Notes</label>
                        <textarea asp-for="Create.Notes" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Create.Notes" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Quote</button>
                </div>
            </form>
        </div>
    </div>
</div>
