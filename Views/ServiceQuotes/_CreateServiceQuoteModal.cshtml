@model FyreApp.ViewModels.ServiceQuotes.ServiceQuoteIndexVm
@using FyreApp.Models
@using FyreApp.Services.ServiceOfferings
@inject IConfiguration Config

@{
    var googleKey = Config["GoogleMaps:BrowserKey"] ?? "";

    var siteFormContext = Model.CreateNewClient ? "new-client" : "none";
}

<div class="modal fade" id="createQuoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" asp-controller="ServiceQuotes" method="post" id="createQuoteForm">
                @Html.AntiForgeryToken()

                <input type="hidden" name="CreateNewClient" id="createNewClientFlag" value="false" />

                <div class="modal-header">
                    <h5 class="modal-title">New Service Quote</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- ── Client section ─────────────────────────────── -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Client</label>

                        <!-- Existing client select -->
                        <div id="sectionExistingClient">
                            <select name="Create.ClientId" id="clientSelect" class="form-select mb-2">
                                <option value="">-- Select client --</option>
                                @foreach (var c in Model.Clients)
                                {
                                    <option value="@c.Id" selected="@(Model.Create.ClientId == c.Id)">@c.Name</option>
                                }
                                <option value="__new__">＋ Create new client...</option>
                            </select>
                            <span class="text-danger small">
                                @(ViewData.ModelState["Create.ClientId"]?.Errors.FirstOrDefault()?.ErrorMessage)
                            </span>

                            <!-- Shown once a client is selected -->
                            <div id="sectionSiteSelect" class="d-none mt-2">
                                <label class="form-label fw-semibold">Property</label>
                                <select name="Create.SiteId" id="siteSelect" class="form-select">
                                    <option value="">-- Select property --</option>
                                    <option value="__new__">+ Add new property…</option>
                                </select>
                                <span class="text-danger small">
                                    @(ViewData.ModelState["Create.SiteId"]?.Errors.FirstOrDefault()?.ErrorMessage)
                                </span>
                            </div>
                        </div>

                        <!-- New client form (hidden initially) -->
                        <div id="sectionNewClient" class="d-none border rounded p-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold small text-muted text-uppercase">New Client</span>
                                <button type="button" class="btn btn-sm btn-link p-0 text-secondary"
                                        id="btnCancelNewClient">← Select existing</button>
                            </div>
                            <div class="row g-2">
                                <div class="col-12">
                                    <input name="NewClient.Name" class="form-control form-control-sm"
                                           placeholder="Client name *" value="@Model.NewClient.Name" />
                                    <span class="text-danger small">
                                        @(ViewData.ModelState["NewClient.Name"]?.Errors.FirstOrDefault()?.ErrorMessage)
                                    </span>
                                </div>
                                <div class="col-md-6">
                                    <input name="NewClient.PrimaryContactName" class="form-control form-control-sm"
                                           placeholder="Contact name" value="@Model.NewClient.PrimaryContactName" />
                                </div>
                                <div class="col-md-6">
                                    <input name="NewClient.PrimaryContactMobile" class="form-control form-control-sm"
                                           placeholder="Mobile" type="tel" value="@Model.NewClient.PrimaryContactMobile" />
                                </div>
                                <div class="col-12">
                                    <input name="NewClient.PrimaryContactEmail" class="form-control form-control-sm"
                                           placeholder="Email *" type="email" value="@Model.NewClient.PrimaryContactEmail" />
                                    <span class="text-danger small">
                                        @(ViewData.ModelState["NewClient.PrimaryContactEmail"]?.Errors.FirstOrDefault()?.ErrorMessage)
                                    </span>
                                </div>
                            </div>

                            <!-- Property (required for new client) -->
                            <hr class="my-3" />
                            <div class="fw-semibold small text-muted text-uppercase mb-2">Property</div>

                            <div class="mb-2">
                                <input name="NewSite.Name" data-site-group="nc"
                                       class="form-control form-control-sm" placeholder="Property name *"
                                       value="@(siteFormContext == "new-client" ? Model.NewSite.Name : "")"
                                       disabled />
                                <span class="text-danger small">
                                    @(siteFormContext == "new-client"
                                        ? ViewData.ModelState["NewSite.Name"]?.Errors.FirstOrDefault()?.ErrorMessage
                                        : null)
                                </span>
                            </div>

                            <input type="hidden" id="cqSitePlaceId" name="NewSite.Google.PlaceId"
                                   data-site-group="nc"
                                   value="@(siteFormContext == "new-client" ? Model.NewSite.Google.PlaceId : "")"
                                   disabled />
                            <input type="hidden" id="cqSiteFormattedAddress" name="NewSite.Google.FormattedAddress"
                                   data-site-group="nc"
                                   value="@(siteFormContext == "new-client" ? Model.NewSite.Google.FormattedAddress : "")"
                                   disabled />

                            <input class="form-control form-control-sm mb-1" id="cqSiteAddressSearch"
                                   type="text" placeholder="Start typing an Australian address…"
                                   autocomplete="one-time-code" disabled />

                            <button type="button" class="btn btn-link btn-sm px-0" id="cqBtnManualAddress"
                                    disabled>
                                Can't find the address? Enter manually
                            </button>

                            <div id="cqManualAddressPanel" class="mt-2 d-none">
                                <div class="mb-2">
                                    <input class="form-control form-control-sm" id="cqAddr1"
                                           name="NewSite.Manual.AddressLine1" data-site-group="nc"
                                           placeholder="Address line 1" maxlength="200"
                                           value="@(siteFormContext == "new-client" ? Model.NewSite.Manual.AddressLine1 : "")"
                                           disabled />
                                </div>
                                <div class="mb-2">
                                    <input class="form-control form-control-sm"
                                           name="NewSite.Manual.AddressLine2" data-site-group="nc"
                                           placeholder="Address line 2" maxlength="200"
                                           value="@(siteFormContext == "new-client" ? Model.NewSite.Manual.AddressLine2 : "")"
                                           disabled />
                                </div>
                                <div class="row g-2">
                                    <div class="col-5">
                                        <input class="form-control form-control-sm"
                                               name="NewSite.Manual.Suburb" data-site-group="nc"
                                               placeholder="Suburb" maxlength="80"
                                               value="@(siteFormContext == "new-client" ? Model.NewSite.Manual.Suburb : "")"
                                               disabled />
                                    </div>
                                    <div class="col-3">
                                        <input class="form-control form-control-sm"
                                               name="NewSite.Manual.State" data-site-group="nc"
                                               placeholder="State" maxlength="20"
                                               value="@(siteFormContext == "new-client" ? Model.NewSite.Manual.State : "")"
                                               disabled />
                                    </div>
                                    <div class="col-4">
                                        <input class="form-control form-control-sm"
                                               name="NewSite.Manual.Postcode" data-site-group="nc"
                                               placeholder="Postcode" maxlength="10"
                                               value="@(siteFormContext == "new-client" ? Model.NewSite.Manual.Postcode : "")"
                                               disabled />
                                    </div>
                                </div>
                            </div>

                            <div class="text-danger small mt-1 d-none" id="cqSiteAddressError"></div>
                        </div>
                    </div>

                    <!-- ── Quote details ──────────────────────────────── -->
                    <label class="form-label fw-semibold">Quote Details</label>

                    <div class="mb-2">
                        <label class="form-label">Service *</label>
                        <select name="Create.ServiceOfferingId" class="form-select">
                            <option value="">-- Select service --</option>
                            @foreach (var offering in Model.ServiceOfferings)
                            {
                                <option value="@offering.Id"
                                        selected="@(Model.Create.ServiceOfferingId == offering.Id ? "selected" : null)">
                                    @offering.Name
                                </option>
                            }
                        </select>
                        <span class="text-danger small">
                            @(ViewData.ModelState["Create.ServiceOfferingId"]?.Errors.FirstOrDefault()?.ErrorMessage)
                        </span>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-8">
                            <input name="Create.Title" class="form-control" placeholder="Title *"
                                   value="@Model.Create.Title" />
                            <span class="text-danger small">
                                @(ViewData.ModelState["Create.Title"]?.Errors.FirstOrDefault()?.ErrorMessage)
                            </span>
                        </div>
                        <div class="col-md-4">
                            <select name="Create.QuoteType" id="createQuoteType" class="form-select">
                                <option value="@((int)ServiceQuoteType.OneTime)"
                                        selected="@(Model.Create.QuoteType == ServiceQuoteType.OneTime)">
                                    One-Time
                                </option>
                                <option value="@((int)ServiceQuoteType.Routine)"
                                        selected="@(Model.Create.QuoteType == ServiceQuoteType.Routine)">
                                    Routine / Contract
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2">
                        <textarea name="Create.Description" class="form-control" rows="2"
                                  placeholder="Description">@Model.Create.Description</textarea>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label">Amount ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input name="Create.Amount" class="form-control" placeholder="Amount"
                                       type="number" min="0" step="0.01" value="@Model.Create.Amount" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Quote Expiry</label>
                            <input name="Create.ExpiryDate" id="quoteExpiry" class="form-control" type="date"
                                   value="@(Model.Create.ExpiryDate.HasValue ? Model.Create.ExpiryDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>
                        <div class="col-md-4 @(Model.Create.QuoteType == ServiceQuoteType.Routine ? "" : "d-none")" id="createIntervalCol">
                            <label class="form-label">Interval</label>
                            <select name="Create.MaintenanceIntervalId" class="form-select">
                                <option value="">-- Select interval --</option>
                                @foreach (var interval in Model.Intervals)
                                {
                                    <option value="@interval.Id"
                                            selected="@(Model.Create.MaintenanceIntervalId == interval.Id ? "selected" : null)">
                                        @interval.Name
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div>
                        <textarea name="Create.Notes" class="form-control" rows="2"
                                  placeholder="Notes">@Model.Create.Notes</textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Quote</button>
                </div>

            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_CreatePropertyModal",
    new FyreApp.ViewModels.Sites.CreatePropertyModalVm
    {
        ClientId    = null,
        ClientName  = "",
        ModalId     = "sqAddPropertyModal",
        IdPrefix    = "sqAddSite",
        ShowClientNameInTitle = false,
        FormController = "Property",
        FormAction     = "CreateAjax",
        GoogleBrowserKey = googleKey
    })

<script>
(function () {
    const modal         = document.getElementById('createQuoteModal');
    const propModalEl   = document.getElementById('sqAddPropertyModal');
    const propModalForm = propModalEl?.querySelector('form.js-create-site-form');
    function getPropModal() { return bootstrap.Modal.getOrCreateInstance(propModalEl); }
    const propClientId  = propModalEl?.querySelector('input[data-role="client-id"]');

    const clientSel   = document.getElementById('clientSelect');
    const secExisting = document.getElementById('sectionExistingClient');
    const secNew      = document.getElementById('sectionNewClient');
    const secSiteSel  = document.getElementById('sectionSiteSelect');
    const siteSel     = document.getElementById('siteSelect');
    const flagClient  = document.getElementById('createNewClientFlag');
    const expiryInput = document.getElementById('quoteExpiry');
    const googleKey   = @Json.Serialize(googleKey);

    const preselectedClientId = @(Model.Create.ClientId.HasValue ? Model.Create.ClientId.Value.ToString() : "null");
    const preselectedSiteId   = @(Model.Create.SiteId.HasValue   ? Model.Create.SiteId.Value.ToString()   : "null");

    const NEW_VALUE = '__new__';

    // ── Interval visibility ──────────────────────────────────────────────────
    const createQuoteTypeSel = document.getElementById('createQuoteType');
    const createIntervalCol  = document.getElementById('createIntervalCol');
    const routineValue       = '@((int)ServiceQuoteType.Routine)';

    function toggleCreateInterval() {
        createIntervalCol.classList.toggle('d-none', createQuoteTypeSel.value !== routineValue);
    }
    createQuoteTypeSel.addEventListener('change', toggleCreateInterval);
    toggleCreateInterval();

    // ── Site-group enable/disable (new-client panel only) ────────────────────
    function setSiteGroup(activeGroup /* "nc" | null */) {
        document.querySelectorAll('[data-site-group]').forEach(el => {
            el.disabled = (el.dataset.siteGroup !== activeGroup);
        });
        const cqInputs = [
            document.getElementById('cqSiteAddressSearch'),
            document.getElementById('cqBtnManualAddress'),
        ];
        cqInputs.forEach(el => { if (el) el.disabled = (activeGroup !== 'nc'); });
    }

    // ── Default expiry ───────────────────────────────────────────────────────
    modal.addEventListener('shown.bs.modal', () => {
        if (!expiryInput.value) {
            const d = new Date();
            d.setDate(d.getDate() + 30);
            expiryInput.value = d.toISOString().split('T')[0];
        }
    });

    // ── Client select ────────────────────────────────────────────────────────
    function showNewClient() {
        secExisting.classList.add('d-none');
        secNew.classList.remove('d-none');
        flagClient.value = 'true';
        setSiteGroup('nc');
        initGooglePlaces('nc');
    }

    function showExistingClient() {
        secNew.classList.add('d-none');
        secExisting.classList.remove('d-none');
        secSiteSel.classList.add('d-none');
        flagClient.value = 'false';
        clientSel.value  = '';
        setSiteGroup(null);
    }

    clientSel.addEventListener('change', function () {
        if (this.value === NEW_VALUE) {
            showNewClient();
        } else if (this.value) {
            flagClient.value = 'false';
            setSiteGroup(null);
            loadSites(this.value, null);
        } else {
            secSiteSel.classList.add('d-none');
            setSiteGroup(null);
        }
    });

    document.getElementById('btnCancelNewClient').addEventListener('click', showExistingClient);

    // ── Site AJAX loader ─────────────────────────────────────────────────────
    function ensureAddNewOption() {
        if (!Array.from(siteSel.options).some(o => o.value === NEW_VALUE)) {
            const opt = document.createElement('option');
            opt.value = NEW_VALUE;
            opt.textContent = '+ Add new property…';
            siteSel.appendChild(opt);
        }
    }

    async function loadSites(clientId, preselectId) {
        secSiteSel.classList.add('d-none');
        siteSel.innerHTML = '<option value="">-- Select property --</option>';

        try {
            const res   = await fetch(`/api/client-sites/${clientId}`);
            const sites = await res.json();

            sites.forEach(s => {
                const opt = document.createElement('option');
                opt.value       = s.id;
                opt.textContent = s.name;
                if (preselectId && String(s.id) === String(preselectId)) opt.selected = true;
                siteSel.appendChild(opt);
            });
            ensureAddNewOption();
            secSiteSel.classList.remove('d-none');
        } catch (e) {
            console.warn('Failed to load sites', e);
        }
    }

    // ── Add new property via modal ───────────────────────────────────────────
    siteSel.addEventListener('change', function () {
        if (this.value !== NEW_VALUE) return;
        if (!clientSel.value) { this.value = ''; return; }
        if (propClientId) propClientId.value = clientSel.value;
        getPropModal().show();
    });

    // Fix z-index so property modal appears above the quote modal
    propModalEl.addEventListener('show.bs.modal', function () {
        setTimeout(() => {
            const backdrops = document.querySelectorAll('.modal-backdrop');
            if (backdrops.length > 0) backdrops[backdrops.length - 1].style.zIndex = '1055';
            propModalEl.style.zIndex = '1056';
        }, 0);
    });

    propModalEl.addEventListener('hidden.bs.modal', function () {
        propModalEl.style.zIndex = '';
        if (siteSel.value === NEW_VALUE) siteSel.value = '';
    });

    propModalForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        // Mirror the validation that _CreatePropertyModal already checks so we bail before fetch
        const placeIdEl   = propModalEl.querySelector('[name="Google.PlaceId"]');
        const manualPanel = propModalEl.querySelector('[id$="_manualAddressPanel"]');
        const addr1El     = propModalEl.querySelector('[name="Manual.AddressLine1"]');
        const isManual    = manualPanel && !manualPanel.classList.contains('d-none');
        if (isManual  && (!addr1El   || !addr1El.value.trim()))   return;
        if (!isManual && (!placeIdEl || !placeIdEl.value.trim())) return;

        const submitBtn = propModalForm.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        try {
            const body = new URLSearchParams(new FormData(propModalForm));
            const res  = await fetch('/Property/CreateAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body
            });
            if (!res.ok) throw new Error(await res.text() || 'Could not create property.');
            const created = await res.json();

            const newOpt    = document.createElement('option');
            newOpt.value    = String(created.id);
            newOpt.textContent = created.name;
            const addNewOpt = Array.from(siteSel.options).find(o => o.value === NEW_VALUE);
            if (addNewOpt) siteSel.insertBefore(newOpt, addNewOpt);
            else           siteSel.appendChild(newOpt);

            siteSel.value = String(created.id);
            getPropModal().hide();
        } catch (err) {
            const errEl = propModalEl.querySelector('[data-role="error"]');
            if (errEl) { errEl.textContent = err?.message || 'Could not create property.'; errEl.classList.remove('d-none'); }
        } finally {
            if (submitBtn) submitBtn.disabled = false;
        }
    });

    // ── Manual address toggle (new-client panel) ─────────────────────────────
    function wireManualToggle(btnId, panelId, placeIdElId, formattedElId) {
        const btn     = document.getElementById(btnId);
        const panel   = document.getElementById(panelId);
        const placeEl = document.getElementById(placeIdElId);
        const fmtEl   = document.getElementById(formattedElId);
        if (!btn || !panel) return;
        btn.addEventListener('click', () => {
            panel.classList.remove('d-none');
            btn.classList.add('d-none');
            if (placeEl) placeEl.value = '';
            if (fmtEl)   fmtEl.value   = '';
        });
    }
    wireManualToggle('cqBtnManualAddress', 'cqManualAddressPanel', 'cqSitePlaceId', 'cqSiteFormattedAddress');

    // ── Address validation on submit (new-client path only) ──────────────────
    function validateSiteAddress(searchId, manualPanelId, addr1Id, errElId, placeIdElId) {
        const search  = document.getElementById(searchId);
        const panel   = document.getElementById(manualPanelId);
        const addr1   = document.getElementById(addr1Id);
        const errEl   = document.getElementById(errElId);
        const placeEl = document.getElementById(placeIdElId);
        const showErr = msg => { if (errEl) { errEl.textContent = msg; errEl.classList.remove('d-none'); } };
        const isManual = panel && !panel.classList.contains('d-none');
        if (isManual) {
            if (!addr1 || !addr1.value.trim()) { showErr('Address line 1 is required.'); addr1?.focus(); return false; }
        } else {
            if (!placeEl || !placeEl.value.trim()) { showErr('Please select an address from the list or enter one manually.'); search?.focus(); return false; }
        }
        return true;
    }

    document.getElementById('createQuoteForm').addEventListener('submit', e => {
        if (flagClient.value === 'true') {
            if (!validateSiteAddress('cqSiteAddressSearch', 'cqManualAddressPanel', 'cqAddr1', 'cqSiteAddressError', 'cqSitePlaceId'))
                e.preventDefault();
        }
    });

    modal.addEventListener('hidden.bs.modal', () => {
        const el = document.getElementById('cqSiteAddressError');
        if (el) { el.textContent = ''; el.classList.add('d-none'); }
    });

    // ── Google Places ────────────────────────────────────────────────────────
    const autocompletes = {};
    function initGooglePlaces(group) {
        if (autocompletes[group] || !googleKey) return;
        if (group !== 'nc') return;

        loadGooglePlacesOnce(googleKey).then(() => {
            const searchEl    = document.getElementById('cqSiteAddressSearch');
            const placeIdEl   = document.getElementById('cqSitePlaceId');
            const formattedEl = document.getElementById('cqSiteFormattedAddress');
            const errEl       = document.getElementById('cqSiteAddressError');
            if (!searchEl) return;

            const ac = new google.maps.places.Autocomplete(searchEl, {
                fields: ['place_id', 'formatted_address'],
                types: ['address']
            });
            ac.setComponentRestrictions({ country: ['au'] });
            ac.addListener('place_changed', () => {
                const place = ac.getPlace();
                if (!place?.place_id) return;
                if (placeIdEl)   placeIdEl.value   = place.place_id;
                if (formattedEl) formattedEl.value  = place.formatted_address ?? '';
                if (errEl)       { errEl.textContent = ''; errEl.classList.add('d-none'); }
            });
            autocompletes[group] = ac;
        }).catch(e => console.warn('Google Places failed to load:', e));
    }

    function loadGooglePlacesOnce(key) {
        if (window.google?.maps?.places) return Promise.resolve();
        if (window.__fyreGooglePlacesPromise) return window.__fyreGooglePlacesPromise;
        window.__fyreGooglePlacesPromise = new Promise((resolve, reject) => {
            const existing = document.querySelector('script[data-fyre-google-places="1"]');
            if (existing) {
                const start = Date.now();
                const t = setInterval(() => {
                    if (window.google?.maps?.places) { clearInterval(t); resolve(); }
                    else if (Date.now() - start > 15000) { clearInterval(t); reject(new Error('Timeout')); }
                }, 50);
                return;
            }
            const cbName = '__fyreGooglePlacesOnLoad';
            window[cbName] = () => resolve();
            const s = document.createElement('script');
            s.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(key)}&libraries=places&callback=${cbName}`;
            s.async = true; s.defer = true; s.dataset.fyreGooglePlaces = '1';
            s.onerror = () => reject(new Error('Failed to load Google Places'));
            document.head.appendChild(s);
        });
        return window.__fyreGooglePlacesPromise;
    }

    // ── Restore state after failed submission ────────────────────────────────
    @if (siteFormContext == "new-client")
    {
        <text>
        showNewClient();
        @if (!string.IsNullOrWhiteSpace(Model.NewSite?.Manual?.AddressLine1))
        {
            <text>
            const _p = document.getElementById('cqManualAddressPanel');
            const _b = document.getElementById('cqBtnManualAddress');
            if (_p) _p.classList.remove('d-none');
            if (_b) _b.classList.add('d-none');
            </text>
        }
        </text>
    }
    else if (Model.Create.ClientId.HasValue)
    {
        <text>loadSites(preselectedClientId, preselectedSiteId);</text>
    }
})();
</script>
