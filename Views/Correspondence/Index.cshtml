@model FyreApp.ViewModels.Lists.CorrespondenceListVm

@{
    ViewData["Title"] = "Correspondence";
    var f = Model.Filter;
    var r = Model.RecordLink;
}

<div class="card">
    <div class="card-header">
        <h1 class="h4 m-0">
            Correspondence
            @if (r != null)
            {
                <span class="fw-normal text-muted">·
                    @r.Kind
                    @if (r.Controller != null) { <a asp-controller="@r.Controller" asp-action="@r.Action" asp-route-id="@r.Id">@r.Name</a> }
                    else { @r.Name }
                </span>
            }
        </h1>
    </div>

    <div class="card-body">
        <form method="get" asp-action="Index" class="mb-3">
            @if (f.Record != null)
            {
                <input type="hidden" name="record" value="@f.Record" />
                <input type="hidden" name="recordId" value="@f.RecordId" />
            }
            <input type="search" name="search" value="@f.Search" class="form-control" placeholder="Search subject, from or to" />
        </form>
        @if (f.Record != null)
        {
            <p class="small"><a asp-action="Index" asp-route-search="@f.Search">Show every email</a></p>
        }

        <p class="small text-muted">@Model.Total.ToString("N0") email@(Model.Total == 1 ? "" : "s")</p>

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No emails match.</p>
        }
        else
        {
            <div class="card mb-3"><partial name="_Rows" model="Model.Items" /></div>
            @await Html.PartialAsync("_ListPager", (f.Page, Model.Pages))
        }
    </div>
</div>
