@model FyreApp.ViewModels.Lists.UsersIndexVm
@using FyreApp.Models

@{
    ViewData["Title"] = "Users";
    var list = Model.List;
    var f = list.Filter;
    var licenses = new[] { "DESK", "FIELD", "CONTRACTOR", "CUSTOMER" };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Unlinked.Count > 0)
{
    <div class="card mb-3 border-warning">
        <div class="card-header">
            <h2 class="h5 m-0">FyreApp logins not in Uptick</h2>
            <div class="small text-muted">
                These logins aren't linked to an Uptick user, so their name and email are FyreApp's own. Link each to its
                Uptick user and it takes its name and email from Uptick. Logins whose email matches an Uptick user are linked
                automatically when the Users export is imported, or with "Update from Uptick".
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Link to Uptick user</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Unlinked)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td><span class="badge bg-secondary">@user.Role</span></td>
                            <td>
                                @if (user.IsActive) { <span class="badge bg-success">Active</span> }
                                else { <span class="badge bg-secondary">Inactive</span> }
                            </td>
                            <td>
                                @if (Model.Linkable.Count > 0)
                                {
                                    <form asp-action="Link" asp-route-id="@user.Id" method="post" class="d-flex gap-2">
                                        <select name="uptickUserId" class="form-select form-select-sm" aria-label="Uptick user" required>
                                            <option value="">Choose…</option>
                                            @foreach (var u in Model.Linkable)
                                            {
                                                <option value="@u.Id">@u.Name@(u.Email != null ? $" ({u.Email})" : "")</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Link</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">No Uptick users without a login</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @await Html.PartialAsync("_LoginActions", new FyreApp.ViewModels.Lists.LoginSummary(user.Id, user.Role, user.IsActive))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-start gap-2">
        <div>
            <h1 class="h4 m-0">Users</h1>
            <div class="small text-muted">
                Everyone with an Uptick login, from Uptick's Users export (Import page). Uptick is the source of truth: a
                FyreApp login takes its name and email from its Uptick user. Give a login to anyone who needs to sign in to FyreApp.
            </div>
        </div>
        <form asp-action="Sync" method="post">
            <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap"
                    title="Link logins to Uptick users by email and copy names and emails from Uptick">Update from Uptick</button>
        </form>
    </div>

    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3">
            <div class="col-sm-12 col-lg-6">
                <input type="search" name="search" value="@f.Search" class="form-control" placeholder="Search name, email or licence" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <select name="license" class="form-select" aria-label="Licence type" onchange="this.form.submit()">
                    <option value="" selected="@string.IsNullOrEmpty(f.License)">All licence types</option>
                    @foreach (var l in licenses)
                    {
                        <option value="@l" selected="@(string.Equals(f.License, l, StringComparison.OrdinalIgnoreCase))">@UptickUser.LicenseLabel(l)</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-3">
                <select name="login" class="form-select" aria-label="FyreApp login" onchange="this.form.submit()">
                    <option value="" selected="@string.IsNullOrEmpty(f.Login)">With or without a login</option>
                    <option value="yes" selected="@(f.Login == "yes")">Has a FyreApp login</option>
                    <option value="no" selected="@(f.Login == "no")">No FyreApp login</option>
                </select>
            </div>
        </form>

        @await Html.PartialAsync("_SelectionToolbar", new FyreApp.ViewModels.Lists.SelectionToolbarVm
        {
            Total = list.Total, PageCount = list.Items.Count, Noun = "Users", NounSingular = "User",
            DownloadUrl = Url.Action("Download") + "?" + FyreApp.ViewModels.Lists.FilterQuery.ToQueryString(f.QueryValues())
        })

        @if (list.Items.Count == 0)
        {
            <p class="text-muted">No users match. Users come from Uptick's Users export (Import page).</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Licence type</th>
                            <th>Security groups</th>
                            <th>Licence</th>
                            <th>Last Uptick login</th>
                            <th>FyreApp login</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in list.Items)
                        {
                            var u = item.User;
                            var login = item.Login;
                            <tr>
                                <td>
                                    @u.Name
                                    @if (u.ServiceGroup != null) { <div class="small text-muted">@u.ServiceGroup</div> }
                                    @foreach (var a in item.Accreditations)
                                    {
                                        <div class="small"><i class="bi bi-patch-check text-muted"></i> @a.Type @a.Number
                                            @if (a.Expiry is { } exp) { <span class="text-muted">· expires @exp.ToOrdinalDate()</span> }
                                        </div>
                                    }
                                </td>
                                <td>@if (u.Email != null) { <a href="mailto:@u.Email">@u.Email</a> } else { <text>-</text> }</td>
                                <td>@UptickUser.LicenseLabel(u.LicenseType)</td>
                                <td class="small">
                                    @if (item.Groups.Any())
                                    {
                                        @foreach (var g in item.Groups) { <span class="badge bg-light text-dark border me-1">@g</span> }
                                    }
                                    else { <text>-</text> }
                                </td>
                                <td class="small">@(u.Licence ?? "-")</td>
                                <td class="text-nowrap">@(u.LastLoginUtc.ToSydney().ToDisplayDate() ?? "Never")</td>
                                <td class="text-nowrap">
                                    @if (login != null)
                                    {
                                        <span class="badge bg-secondary">@(login.Role ?? "No role")</span>
                                        @if (login.IsActive) { <span class="badge bg-success">Active</span> }
                                        else { <span class="badge bg-secondary">Inactive</span> }
                                    }
                                    else { <span class="text-muted">-</span> }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (login != null)
                                    {
                                        @await Html.PartialAsync("_LoginActions", login)
                                    }
                                    else if (u.Email != null && u.LicenseType != "CUSTOMER")
                                    {
                                        <a asp-action="Create" asp-route-uptickUserId="@u.Id" class="btn btn-sm btn-outline-primary">Give login</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_ListPager", (f.Page, list.Pages))
        }
    </div>
</div>
