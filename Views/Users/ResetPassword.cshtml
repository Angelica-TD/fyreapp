@model FyreApp.Services.UserManagement.UserResetPasswordDto

@{
    ViewData["Title"] = "Reset Password";
}

<h1>Reset Password</h1>
<p class="text-muted">Setting a new password for <strong>@ViewBag.UserName</strong>.</p>

<div class="row">
    <div class="col-md-6">
        <form asp-action="ResetPassword" asp-route-id="@ViewBag.UserId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" type="password" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
                <div class="form-text">Must be at least 8 characters with uppercase, number, and special character.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Set Password</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
