@model FyreApp.ViewModels.Lists.DirectoryListVm<FyreApp.ViewModels.Lists.UptickUserListItemVm>
@using FyreApp.Models

@{
    ViewData["Title"] = "Uptick users";
    ViewData["Breadcrumbs"] = new (string, string?)[] { ("Home", Url.Action("Index", "Home")), ("Users", Url.Action("Index")), ("Uptick users", null) };
    var f = Model.Filter;
    var licenses = new[] { "DESK", "FIELD", "CONTRACTOR", "CUSTOMER" };
}

<div class="card">
    <div class="card-header">
        <h1 class="h4 m-0">Uptick users</h1>
        <div class="small text-muted">
            Everyone with an Uptick login, from Uptick's Users export. They're a record only and don't log in to FyreApp;
            <a asp-action="Index">FyreApp users</a> with the same email are marked.
        </div>
    </div>

    <div class="card-body">
        <form method="get" asp-action="Uptick" class="row g-2 mb-3">
            <div class="col-sm-8 col-lg-9">
                <input type="search" name="search" value="@f.Search" class="form-control" placeholder="Search name, email or licence" />
            </div>
            <div class="col-sm-4 col-lg-3">
                <select name="license" class="form-select" aria-label="Licence type" onchange="this.form.submit()">
                    <option value="" selected="@string.IsNullOrEmpty(f.License)">All licence types</option>
                    @foreach (var l in licenses)
                    {
                        <option value="@l" selected="@(string.Equals(f.License, l, StringComparison.OrdinalIgnoreCase))">@UptickUser.LicenseLabel(l)</option>
                    }
                </select>
            </div>
        </form>

        @await Html.PartialAsync("_SelectionToolbar", new FyreApp.ViewModels.Lists.SelectionToolbarVm
        {
            Total = Model.Total, PageCount = Model.Items.Count, Noun = "Users", NounSingular = "User",
            DownloadUrl = Url.Action("UptickDownload") + "?" + FyreApp.ViewModels.Lists.FilterQuery.ToQueryString(f.QueryValues())
        })

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No users match. Users come from Uptick's Users export (Import page).</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Licence type</th>
                            <th>Security groups</th>
                            <th>Licence</th>
                            <th>Last login</th>
                            <th>FyreApp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var u = item.User;
                            <tr>
                                <td>
                                    @u.Name
                                    @if (u.ServiceGroup != null) { <div class="small text-muted">@u.ServiceGroup</div> }
                                </td>
                                <td>@if (u.Email != null) { <a href="mailto:@u.Email">@u.Email</a> } else { <text>-</text> }</td>
                                <td>@UptickUser.LicenseLabel(u.LicenseType)</td>
                                <td class="small">@(u.SecurityGroups ?? "-")</td>
                                <td class="small">@(u.Licence ?? "-")</td>
                                <td class="text-nowrap">@(u.LastLoginUtc.ToSydney().ToDisplayDate() ?? "Never")</td>
                                <td>
                                    @if (item.HasFyreAppLogin) { <span class="badge bg-success">Has login</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_ListPager", (f.Page, Model.Pages))
        }
    </div>
</div>
