@model FyreApp.ViewModels.Tasks.TaskPageVm
@using System.Globalization
@using FyreApp.Infrastructure
@using FyreApp.Models
@using FyreApp.ViewModels.Tasks

@* The task page, laid out like Uptick's: client / property, status, category and ref above Task and Work tabs.
   The Task tab has the details on the left, process and notes in the middle, and schedule and access on the right. *@
@{
    var t = Model.Task;
    var site = t.Property;
    ViewData["Title"] = $"{t.DisplayRef} {t.Title}".Trim();
    ViewData["Breadcrumbs"] = new (string, string?)[] { ("Home", Url.Action("Index", "Home")), ("Tasks", Url.Action("Index")), (t.DisplayRef ?? t.Title, null) };
    var isAdmin = User.IsInRole("Admin");
    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;

    // Uptick's export dates ("2026-10-13 15:16:23", Brisbane time) as Uptick shows them ("13th Oct 2026")
    string? UDate(string header) =>
        Model.U(header) is { } s && DateTime.TryParse(s, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d.ToOrdinalDate() : Model.U(header);
    string? Money(string header) =>
        Model.U(header) is { } s && decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var m) ? m.ToString("C", CultureInfo.GetCultureInfo("en-AU")) : Model.U(header);

    // One line per line of the address; Uptick wraps "181 Gemvale Rd, Mudgeeraba, Qld, 4213" rather than splitting it
    var addressLines = (site.AddressDisplay ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var suburb = string.Join(" ", new[] { site.Suburb, site.State, site.Postcode }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var uptickOther = FyreApp.Services.Tasks.TaskListService.OtherUptickTechnician(t.AssignedTo?.Name, t.UptickTechnician);
    var supporting = (Model.U("Supporting Technicians") ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var accessSchedule = site.AccessSchedule switch { null or "" => null, "NR" => "Needs review", var s => s };
    var isRoutineTask = Model.Routines.Any() || t.MaintenanceScheduleId.HasValue || t.CoveredSchedules.Any();
}

<div class="task-page">
    @* Client / property *@
    <div class="task-crumbs mb-1">
        <i class="bi bi-person-fill"></i>
        <a asp-controller="Clients" asp-action="Details" asp-route-id="@t.ClientId">@t.Client.Name</a>
        <span class="text-muted mx-2">/</span>
        <i class="bi bi-building"></i>
        <a asp-controller="Property" asp-action="Details" asp-route-id="@t.PropertyId"><strong>@site.DisplayRef @site.Name</strong></a>
        @if (suburb != "") { <span class="text-muted">@suburb</span> }
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
        <h1 class="task-title mb-0">
            <span class="badge task-status align-middle">@Model.StatusLabel</span>
            @if (t.Category != null) { <span class="badge bg-dark align-middle">@t.Category.ToUpperInvariant()</span> }
            <span class="align-middle">@t.DisplayRef @t.Title</span>
            @if (Model.Subtitle != null) { <span class="task-subtitle align-middle">@Model.Subtitle</span> }
        </h1>
        <div class="d-flex gap-2">
            @if (t.Status != ClientTaskStatus.Completed)
            {
                <form asp-action="Complete" asp-route-id="@t.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Mark this task complete?')">Mark complete</button>
                </form>
            }
            <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Delete</a>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    @await Component.InvokeAsync("LocalEdits", new { entity = "ClientTask", id = Model.Task.Id })

    <ul class="nav nav-tabs task-tabs mb-3">
        @foreach (var (key, label) in TaskPageVm.Tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(key == Model.Tab ? "active" : "")" asp-action="Details" asp-route-id="@t.Id"
                   asp-route-tab="@(key == "task" ? null : key)">
                    @if (key == "work")
                    {
                        @($"{label} ({Model.WorkDone}/{Model.WorkTotal})")
                        @if (Model.WorkTotal > 0 && Model.WorkDone == Model.WorkTotal) { <i class="bi bi-check-circle-fill"></i> }
                    }
                    else { @label }</a>
            </li>
        }
    </ul>

    @if (Model.Tab == "work")
    {
        @* Work, as Uptick lays it out: Asset Maintenance (the routines it does, then the assets it services for them and
           whether each was serviced), any asset repairs, and the Remark registry (remarks identified or resolved on it) *@
        <h2 class="h4 pb-2 mb-3 border-bottom">Activities</h2>
        @if (Model.ServiceAssets.Any() || Model.ServiceRoutines.Any())
        {
            <h3 class="h5 mb-2">Asset Maintenance</h3>
            <div class="card property-card">
                @if (Model.Visits.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>ID</th><th>Routine</th><th title="Not in Uptick's exports">Visit fee</th><th class="work-progress">Activities</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var (name, v) in Model.Visits)
                                {
                                    var assets = Model.ServiceAssets.Where(a => string.Equals(a.Routine, name, StringComparison.OrdinalIgnoreCase)).ToList();
                                    var done = assets.Count(a => Model.Performed(a.Asset) != null);
                                    <tr>
                                        <td class="text-nowrap">@(v == null ? "-" : v.UptickId?.ToString() ?? v.Id.ToString())</td>
                                        <td>@name@(v == null ? "" : $" ({v.DueDate.ToOrdinalDate()})")</td>
                                        <td class="text-nowrap text-muted">-</td>
                                        <td class="work-progress text-nowrap">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" role="progressbar" aria-label="Assets serviced" aria-valuenow="@done" aria-valuemin="0" aria-valuemax="@assets.Count">
                                                    <div class="progress-bar bg-success" style="width: @(assets.Count == 0 ? 0 : done * 100 / assets.Count)%"></div>
                                                </div>
                                                <span>@done / @assets.Count</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (Model.ServiceAssets.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>Asset</th><th>Routine</th><th>Performed</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var (routine, a) in Model.ServiceAssets)
                                {
                                    var performed = Model.Performed(a);
                                    var identified = Model.Remarks.Count(r => !r.Resolved && r.Remark.AssetId == a.Id);
                                    <tr>
                                        <td>
                                            <a asp-controller="Assets" asp-action="Details" asp-route-id="@a.Id">@(a.Ref != null ? $"{a.Ref} - {a.Name}" : a.Name)</a>
                                            @if (Model.OpenRemarks.TryGetValue(a.Id, out var open))
                                            {
                                                <span class="badge bg-secondary" title="@open open @(open == 1 ? "remark" : "remarks")">@open</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(a.Location)) { <div class="small text-muted">@a.Location</div> }
                                        </td>
                                        <td>@routine</td>
                                        <td class="text-nowrap">
                                            @if (performed is DateTime on)
                                            {
                                                @if (AssetCompliance.ListBadge(a.Compliance) is { } result) { <span class="badge @result.Css">@result.Text</span> }
                                                <div class="text-muted">@on.ToOrdinalDate()</div>
                                            }
                                            else { <span class="text-muted">-</span> }
                                        </td>
                                        <td class="text-nowrap text-end">
                                            @if (identified > 0)
                                            {
                                                <span class="text-danger" title="@identified @(identified == 1 ? "remark" : "remarks") identified on this task">
                                                    <i class="bi bi-exclamation-triangle-fill"></i>+@identified
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card-body text-muted fst-italic">
                        No assets at this property for @string.Join(", ", Model.ServiceRoutines). Assets are matched by their asset type's
                        applicable routines (Uptick's asset types export).
                    </div>
                }
            </div>
        }
        @if (Model.Repairs.Any() || !Model.ServiceRoutines.Any())
        {
            <h3 class="h5 mb-2">Asset Repair</h3>
            <div class="card property-card">
                @if (!Model.Repairs.Any())
                {
                    <div class="card-body text-muted fst-italic">No asset repairs on this task.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>Asset</th><th>Remark</th><th>Description</th><th>Resolution</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Repairs)
                                {
                                    <tr>
                                        <td>
                                            @if (d.Asset != null)
                                            {
                                                <a asp-controller="Assets" asp-action="Details" asp-route-id="@d.Asset.Id">@d.Asset.Name</a>
                                                @if (!string.IsNullOrWhiteSpace(d.Asset.Location)) { <div class="small text-muted">@d.Asset.Location</div> }
                                            }
                                            else { <span class="text-muted">-</span> }
                                        </td>
                                        <td class="text-nowrap">
                                            @if (d.Active) { <span class="small fw-semibold text-warning">TO RESOLVE</span> }
                                            else { <span class="small fw-semibold text-success">RESOLVED</span> }
                                            @await Html.PartialAsync("_RemarkRef", d)
                                            @if (d.RemarkType != null) { <div class="small text-muted">@d.RemarkType</div> }
                                        </td>
                                        <td>@Dash(d.Description)</td>
                                        <td>@Dash(d.Resolution)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        <h3 class="h5 mb-2 mt-4">Remark registry</h3>
        <div class="card property-card">
            @if (!Model.Remarks.Any())
            {
                <div class="card-body text-muted fst-italic">No remarks identified or resolved on this task.</div>
            }
            else
            {
                var resolvedCount = Model.Remarks.Count(r => r.Resolved);
                var identifiedCount = Model.Remarks.Count - resolvedCount;
                <div class="card-body d-flex gap-2 pb-0">
                    @if (resolvedCount > 0) { <span class="badge bg-success">@resolvedCount @(resolvedCount == 1 ? "REMARK" : "REMARKS") RESOLVED</span> }
                    @if (identifiedCount > 0) { <span class="badge bg-warning text-dark">@identifiedCount @(identifiedCount == 1 ? "REMARK" : "REMARKS") IDENTIFIED</span> }
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr><th>Asset</th><th>Remarks</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var byAsset in Model.Remarks.GroupBy(r => r.Remark.AssetId))
                            {
                                var a = byAsset.First().Remark.Asset;
                                <tr>
                                    <td class="align-top">
                                        @if (a != null)
                                        {
                                            <a asp-controller="Assets" asp-action="Details" asp-route-id="@a.Id">@(a.Ref != null ? $"{a.Ref} - {a.Name}" : a.Name)</a>
                                        }
                                        else { <span class="text-muted">Property</span> }
                                    </td>
                                    <td>
                                        @foreach (var (d, isResolved) in byAsset)
                                        {
                                            <div class="d-flex gap-3 align-items-baseline py-1">
                                                @if (isResolved) { <span class="badge bg-success">RESOLVED</span> }
                                                else { <span class="badge bg-warning text-dark">ADDED</span> }
                                                <span class="text-nowrap">@await Html.PartialAsync("_RemarkRef", d)</span>
                                                <span>@Dash(d.Description)</span>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <partial name="_Subtasks" model="Model" />
        <p class="small text-muted mt-2">
            An asset counts as performed when Uptick's line for it on this task was performed (for a task made in FyreApp,
            when the asset's last service falls while the task's work was being done). Time logged and
            stock used are on the Time and Stock tabs.
        </p>
    }
    else if (Model.Tab == "time")
    {
        <partial name="_TimeTab" model="Model" />
    }
    else if (Model.Tab == "stock")
    {
        <partial name="_StockTab" model="Model" />
    }
    else
    {
        <div class="row g-3">
            @* Details *@
            <div class="col-lg-6 col-xl-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h4 mb-0">Details</h2>
                    @if (isAdmin) { <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-light border">Edit</a> }
                </div>
                @if (Model.Subtitle != null) { <p class="text-muted">@Model.Subtitle</p> }

                <div class="task-detail">
                    @if (Model.U("Parent Task") is { } parent)
                    {
                        <div class="task-detail-item">
                            <i class="bi bi-diagram-2"></i>
                            <div><div class="fw-semibold">Originated from</div>@parent</div>
                        </div>
                    }
                    <div class="task-detail-item">
                        <i class="bi bi-building"></i>
                        <div>
                            <div class="fw-semibold">Property</div>
                            <a asp-controller="Property" asp-action="Details" asp-route-id="@t.PropertyId">@site.DisplayRef @site.Name</a>
                            @foreach (var line in addressLines) { <div>@line</div> }
                        </div>
                    </div>
                    <div class="task-detail-item">
                        <i class="bi bi-person-fill"></i>
                        <div>
                            <div class="fw-semibold">Client</div>
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@t.ClientId">@t.Client.Name</a>
                            @if (Model.U("Primary Contact Name") is { } contact) { <div>@contact</div> }
                            @if (Model.U("Primary Contact Email") is { } email) { <div class="text-break"><a href="mailto:@email">@email</a></div> }
                        </div>
                    </div>
                    @if (Model.U("Billing Card Name") is { } billing)
                    {
                        <div class="task-detail-item">
                            <i class="bi bi-file-earmark-text"></i>
                            <div><div class="fw-semibold">Billing card</div>@billing.ToUpperInvariant()</div>
                        </div>
                    }
                    @if (Model.U("Authorisation Ref") != null || Model.U("Authorisation Amount") != null)
                    {
                        <div class="task-detail-item">
                            <i class="bi bi-upc"></i>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">Authorisation</div>
                                <div class="task-authorisation">
                                    @if (Model.U("Authorisation Ref") is { } authRef) { <div><i class="bi bi-hash"></i> @authRef</div> }
                                    @if (Money("Authorisation Amount") is { } amount) { <div><i class="bi bi-currency-dollar"></i> @amount</div> }
                                </div>
                            </div>
                        </div>
                    }
                    <div class="task-detail-item border-top pt-2">
                        <i class="bi bi-grid-3x2-gap"></i>
                        <div><div class="fw-semibold">Service group</div>@Dash(Model.U("Service Group"))</div>
                    </div>
                    @if (isRoutineTask)
                    {
                        <div class="task-detail-item">
                            <i class="bi bi-arrow-repeat"></i>
                            <div>
                                <div class="fw-semibold">Routines</div>
                                @foreach (var r in Model.Routines) { <div>@r</div> }
                                @foreach (var s in t.CoveredSchedules.OrderBy(s => s.MaintenanceInterval.Months)) { <div>@s.MaintenanceInterval.Name</div> }
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@t.PropertyId" asp-route-tab="routines">Property's routines</a>
                            </div>
                        </div>
                    }
                </div>

                <h3 class="h6 border-top pt-3 mt-3">Responsible Persons</h3>
                @if (Model.U("Assigned Office") is { } office)
                {
                    <div class="task-person">
                        <span class="task-avatar task-avatar-office">@TaskPageVm.Initials(office)</span>
                        <div><div>@office</div><div class="small text-muted">Office assignee</div></div>
                    </div>
                }
                @if (Model.U("Salesperson") is { } sales)
                {
                    <div class="task-person">
                        <span class="task-avatar task-avatar-office">@TaskPageVm.Initials(sales)</span>
                        <div><div>@sales</div><div class="small text-muted">Salesperson</div></div>
                    </div>
                }
                <div class="task-person text-muted">
                    <span class="task-avatar task-avatar-empty"><i class="bi bi-list-ul"></i></span>
                    <div>@(Model.U("Round") ?? "No round")</div>
                </div>
            </div>

            @* Process and notes *@
            <div class="col-lg-6 col-xl-5">
                <div class="card property-card">
                    @if (Model.Tags.Any())
                    {
                        <div class="card-body border-bottom bg-light py-2">
                            @foreach (var tag in Model.Tags) { <span class="badge bg-danger fs-6 fw-normal me-1">@tag</span> }
                        </div>
                    }
                    <div class="card-body">
                        <h2 class="h4 mb-3">Process</h2>

                        <div class="task-process mb-3">
                            <div class="task-process-head">
                                <i class="bi bi-receipt"></i> Invoices
                                <span class="mx-1">·</span>
                                <strong>@(Model.Invoices.Any() || Model.U("Invoiced") is "True" or "true" or "Yes" ? "Invoiced" : "Work pending")</strong>
                            </div>
                            @foreach (var i in Model.Invoices)
                            {
                                <div class="task-process-row">
                                    <i class="bi bi-arrow-return-right text-muted"></i>
                                    <span class="badge bg-light text-muted border">@(i.Status ?? "INVOICE")</span>
                                    <a asp-controller="Billing" asp-action="Invoice" asp-route-id="@i.Id">@i.Number</a>
                                    <span class="text-muted">@(i.Date?.ToOrdinalDate() ?? "")</span>
                                    <span class="ms-auto">@(i.Total?.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-AU")) ?? "")</span>
                                </div>
                            }
                        </div>

                        @if (Model.Forms.Any())
                        {
                            <div class="task-process mb-3">
                                <div class="task-process-head">
                                    <i class="bi bi-ui-checks"></i> Forms
                                    <span class="mx-1">·</span>
                                    <strong>@Model.Forms.Count submitted</strong>
                                </div>
                                @foreach (var (form, submitter) in Model.Forms)
                                {
                                    <div class="task-process-row">
                                        <i class="bi bi-arrow-return-right text-muted"></i>
                                        <span>@(form.TemplateName ?? "Form")@(form.Ref != null ? $" {form.Ref}" : "")</span>
                                        <span class="text-muted">@(form.SubmittedUtc?.ToSydney().ToOrdinalDate() ?? "")@(submitter != null ? $" by {submitter}" : "")</span>
                                        @if (!form.IsComplete) { <span class="badge bg-warning text-dark">Incomplete</span> }
                                    </div>
                                }
                            </div>
                        }

                        <div class="task-process mb-4">
                            <div class="task-process-head">
                                <i class="bi bi-file-earmark-text"></i> Reports
                                <span class="mx-1">·</span>
                                <strong>@(Model.Reports.Count == 0 ? "No reports" : $"{Model.Reports.Count} report{(Model.Reports.Count == 1 ? "" : "s")}")</strong>
                            </div>
                            @foreach (var r in Model.Reports)
                            {
                                <div class="task-process-row">
                                    <i class="bi bi-arrow-return-right text-muted"></i>
                                    <span class="badge bg-light text-muted border text-uppercase">@(r.ReportType ?? "Report")</span>
                                    <span><partial name="_ReportRef" model="(r.Id, r.DisplayRef, r.UptickId is { } rid && Model.ReportPdfs.TryGetValue(rid, out var pdf) ? pdf : (int?)null)" /></span>
                                    <span class="text-muted">inspected @(r.InspectedDate.ToOrdinalDate() ?? "-")</span>
                                    @if (r.Compliant == false) { <span class="badge bg-danger">Not compliant</span> }
                                    @if (r.Published) { <span class="badge bg-success">Published</span> }
                                </div>
                            }
                        </div>

                        <h2 class="h4 mb-3">Notes</h2>
                        <div class="fw-semibold mb-1">Scope of works</div>
                        <div class="task-note mb-3">@Dash(Model.ScopeOfWorks)</div>

                        <div class="fw-semibold mb-1">Technician note <i class="bi bi-eye text-muted" title="Technicians see this"></i></div>
                        <div class="task-note mb-3 @(Model.U("Technician Note") == null ? "task-note-empty" : "")">@(Model.U("Technician Note") ?? "No technician note")</div>

                        <div class="fw-semibold mb-1">Invoice note</div>
                        <div class="task-note mb-3 @(Model.U("Invoice Note") == null ? "task-note-empty" : "task-note-invoice")">@(Model.U("Invoice Note") ?? "No invoice note")</div>

                        @if (Model.U("Internal Note") is { } internalNote)
                        {
                            <div class="fw-semibold mb-1">Internal note</div>
                            <div class="task-note mb-3">@internalNote</div>
                        }
                    </div>
                </div>

                @await Component.InvokeAsync("UptickFiles", new { resource = "tasks", uptickId = t.UptickId })
                @await Component.InvokeAsync("Correspondence", new { resource = "tasks", uptickId = t.UptickId })
                @await Component.InvokeAsync("UptickRecord", new { resource = "tasks", uptickId = t.UptickId })
            </div>

            @* Schedule and access *@
            <div class="col-lg-12 col-xl-4">
                <div class="card property-card">
                    <div class="card-body">
                        <dl class="row task-facts mb-0">
                            <dt class="col-7"><i class="bi bi-stopwatch-fill"></i> @(t.DueDateUtc is { } due ? $"Due {due.ToSydney().ToOrdinalDate()}" : "No due date")</dt>
                            <dd class="col-5 text-end">@if (isAdmin) { <a asp-action="Edit" asp-route-id="@t.Id">Edit</a> }</dd>
                            <dt class="col-7">Estimated time</dt>
                            <dd class="col-5 text-end">@Dash(Model.U("Est. Duration"))</dd>
                            <dt class="col-7">Priority</dt>
                            <dd class="col-5 text-end">@t.Priority</dd>
                            <dt class="col-7">On-site</dt>
                            <dd class="col-5 text-end">@Dash(UDate("On-site Date"))</dd>
                            <dt class="col-7">Performed</dt>
                            <dd class="col-5 text-end">@Dash(UDate("Performed Date"))</dd>
                            @if (t.CompletedUtc is { } done)
                            {
                                <dt class="col-7">Completed</dt>
                                <dd class="col-5 text-end">@done.ToSydney().ToOrdinalDate()</dd>
                            }
                        </dl>
                    </div>

                    <div class="card-body border-top">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-5">Schedule</span>
                            @if (t.AssignedTo != null) { <span class="task-avatar">@TaskPageVm.Initials(t.AssignedTo.Name)</span> }
                        </div>

                        <div class="fw-semibold mb-2">Assign field staff</div>
                        @if (t.AssignedTo != null)
                        {
                            <div class="task-staff mb-2">
                                <span class="task-avatar">@TaskPageVm.Initials(t.AssignedTo.Name)</span>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@t.AssignedTo.Name</div>
                                    <div class="small text-muted">Primary @(t.AssignedTo.LicenseType == "CONTRACTOR" ? "Contractor" : "Technician")</div>
                                </div>
                            </div>
                        }
                        else if (uptickOther == null)
                        {
                            <p class="text-muted mb-2">No technician assigned.</p>
                        }
                        @if (uptickOther != null)
                        {
                            <div class="small text-muted mb-2">@uptickOther · assigned in Uptick</div>
                        }
                        @foreach (var s in supporting)
                        {
                            <div class="task-staff mb-2">
                                <span class="task-avatar task-avatar-office">@TaskPageVm.Initials(s)</span>
                                <div><div>@s</div><div class="small text-muted">Supporting Technician</div></div>
                            </div>
                        }
                        @if (isAdmin)
                        {
                            <form asp-action="Assign" asp-route-id="@t.Id" method="post" class="d-flex gap-2 mb-3">
                                <select name="technicianId" class="form-select form-select-sm" aria-label="Technician">
                                    <option value="">— Unassigned —</option>
                                    @if (t.AssignedTo != null && !Model.Techs.Any(x => x.Id == t.AssignedTo.Id.ToString()))
                                    {
                                        <option value="@t.AssignedTo.Id" selected>@t.AssignedTo.Name</option>
                                    }
                                    @foreach (var (id, name) in Model.Techs)
                                    {
                                        <option value="@id" selected="@(t.AssignedToUptickUserId?.ToString() == id)">@name</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Assign</button>
                            </form>
                        }

                        <div class="fw-semibold mb-1">Appointments</div>
                        <p class="mb-0 @(Model.U("Scheduled Date") == null ? "text-muted" : "")">
                            @(UDate("Scheduled Date") is { } scheduled ? $"Scheduled {scheduled}" : "Not scheduled")
                        </p>
                    </div>

                    <div class="card-body border-top">
                        <div class="fs-5 mb-3">Access Information</div>
                        <dl class="row task-facts mb-0">
                            <dt class="col-5">Access</dt>
                            <dd class="col-7">
                                @if (accessSchedule == "Needs review") { <span class="badge bg-danger text-uppercase">Needs review</span> }
                                else { @Dash(accessSchedule) }
                            </dd>
                            <dt class="col-5">Procedure</dt>
                            <dd class="col-7">@Dash(site.AccessProcedure)</dd>
                            <dt class="col-5">Access Code</dt>
                            <dd class="col-7">@Dash(site.AccessCode)</dd>
                            @if (Model.U("Access Window") is { } window)
                            {
                                <dt class="col-5">Access Window</dt>
                                <dd class="col-7">@window</dd>
                            }
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(site.AccessNote))
                        {
                            <div class="fw-semibold mt-2 mb-1">Access Note</div>
                            @if (site.AccessNote.Length <= 80)
                            {
                                <div class="task-note">@site.AccessNote</div>
                            }
                            else
                            {
                                @* Uptick shows the start of a long note with "Show more" *@
                                <details class="task-note task-access-note">
                                    <summary>@site.AccessNote[..80]… <span class="task-show-more">Show more</span></summary>
                                    <div class="mt-2">@site.AccessNote</div>
                                </details>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
