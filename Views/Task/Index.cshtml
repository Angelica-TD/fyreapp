@model FyreApp.ViewModels.Tasks.TaskIndexVm

@{
    ViewData["Title"] = "Tasks";
}

<h1 class="m-0">Tasks</h1>

<div class="d-flex justify-content-between">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Create task
    </a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success">@successMsg</div>
}

<div class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <div id="task-search-root" data-can-edit="@(User.IsInRole("Admin") ? "true" : "false")"
             data-techs="@System.Text.Json.JsonSerializer.Serialize(Model.Techs.Select(t => new { id = t.Id, name = t.Name }))"></div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/react/assets/taskSearch.js" asp-append-version="true"></script>
}
